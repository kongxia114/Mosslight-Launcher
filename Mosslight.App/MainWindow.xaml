<Window x:Class="Mosslight.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Mosslight.App.Infrastructure"
        xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
        Title="Mosslight Launcher"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1440" Height="900"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Background="{DynamicResource BgPageBrush}"
        WindowStyle="None"
        ResizeMode="CanResize">

  <!--
    ============================================================================
     自绘窗口框架（PCL2 那种：没有系统标题栏，圆角由 DWM 直接给）

     ⚠️ 为什么是 `WindowChrome` 而不是 `AllowsTransparency="True"`：
        AllowsTransparency 会把整个窗口变成一个**分层位图**（WPF 逐帧把界面画到
        一张 ARGB 图上再推给 DWM），等于把整窗降级成软件渲染 —— 这个工程的
        缓动动画（个性化页那几档）会明显掉帧。
        走 WindowChrome 保持普通 HWND：硬件渲染、DWM 阴影、贴边吸附都在，
        圆角交给 Win11 的 DWM（见 code-behind 里的四角设置）。

     ⚠️ `CaptionHeight="40"` 是**关键**：它把顶部 40px 声明成"原生标题栏"。
        于是拖动窗口、双击最大化/还原、拖到屏幕边缘吸附、右键系统菜单
        全部由 Windows 处理 —— 如果改用 `MouseLeftButtonDown → DragMove()`，
        这些**全都会丢**（DragMove 只是让窗口跟着鼠标走）。
        代价是这一条里的控件必须标 `WindowChrome.IsHitTestVisibleInChrome="True"`，
        否则点击会被当成"拖窗口"吃掉。

     ⚠️ `UseAeroCaptionButtons="False"` 不能省：否则系统会在右上角预留
        最小化/最大化/关闭三颗**看不见的**系统按钮的点击区，正好压在我们的按钮上。
    ============================================================================
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <!--
    窗口结构（跟 1.0.0 的 ui/main_window.py 一致）：

      ┌──────────────────────────────────────────┐
      │ 背景画布（背景图 + 压暗）                  │  ← 铺满整窗，在**最底下**
      │ ┌────────┬───────────────────────────────┐│
      │ │ 侧边栏 │ 页面（ContentControl）         ││
      │ │ 224px  │                               ││
      │ └────────┴───────────────────────────────┘│
      └──────────────────────────────────────────┘

    ⚠️ 窗口自己那层底色**必须不透明**（BgPageBrush）：铺法选「居中 / 适应」时
       图以外的地方画布是不画的，露出来的就是这层。而侧边栏和页面都是**半透明**的
       （设了背景图时侧栏 82%），这样背景图能从它们后面透出来。
  -->
  <Grid>
    <Grid.RowDefinitions>
      <!-- 第 0 行就是 WindowChrome 的 caption 区，高度必须跟上面 CaptionHeight 一致 -->
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================ 自绘标题栏 ============================
         左：启动器名字（就是原来侧边栏顶上那个 BrandText）
         右：最小化 / 关闭（**不做最大化按钮**，跟 PCL2 一致；双击标题栏仍能最大化）
         底色跟侧边栏同一个 Brush：设了背景图时它是 82% 透明，跟整窗透出来的
         背景图同一档，不会出现"标题栏比侧栏实一截"的割裂感。 -->
    <Border Grid.Row="0"
            x:Name="TitleBar"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 品牌：图标（矢量）+ 名字。

             ⚠️ 这里**在 XAML 里手写**而不是调 `NavIcons.Create("brand")`，是为了
                `Stroke="{DynamicResource AccentBrush}"` 这一句。
                个性化里换强调色时，`ThemeApplier.ApplyPalette` 会把
                `Application.Resources["AccentBrush"]` **替换成另一个 brush 对象**；
                而代码里 `(Brush)FindResource(...)` 取到的是**当时那个对象**，
                绑死在图标上，换色之后它还是旧颜色（真踩过）。
                DynamicResource 解析的是"资源键"，替换后自动刷新。

             ⚠️ 结构必须照 `NavIcons.Create` 来：外层 Viewbox 给显示尺寸，
                里面垫一层 **24×24 的 Canvas**，Path 自己不要 Stretch。
                直接缩 Path 会按每个图形各自的边界缩，方块（画得满）和
                导航里那些留白多的图标就会一大一小。 -->
        <StackPanel Grid.Column="0" x:Name="BrandHost" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="18,0,0,0">
          <Viewbox Width="22" Height="22" Stretch="Uniform"
                   VerticalAlignment="Center" Margin="0,0,9,0">
            <Canvas Width="24" Height="24">
              <Path Data="{StaticResource Icon.Box}"
                    Stroke="{DynamicResource AccentBrush}"
                    StrokeThickness="2.5"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
          <TextBlock x:Name="BrandText" Style="{StaticResource ShellBrandText}" />
        </StackPanel>

        <!-- ⚠️ IsHitTestVisibleInChrome 只标在按钮这一层，
             左边空白仍然归 caption 区管 —— 那里拖窗口是正常的。 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Style="{StaticResource ShellTitleBarButton}"
                  Click="OnMinimizeClick" ToolTip="{loc:Tr 最小化}">
            <!-- ⚠️ 框高必须给 1（不是 10）：`Path` 的 Width/Height 只是**布局尺寸**，
                 图形本身按自己的坐标画。在 10×10 的框里写 y=0.5，那根线会贴在框顶、
                 视觉上比关闭那个叉高一截；框高给 1 让布局盒跟线一样粗，
                 ContentPresenter 才会把它正对到标题栏中线。 -->
            <Path Width="10" Height="1" Stretch="None" StrokeThickness="1"
                  Stroke="{Binding Foreground, ElementName=MinimizeButton}"
                  Data="M0,0.5 L10,0.5" />
          </Button>

          <Button x:Name="CloseButton" Style="{StaticResource ShellTitleBarCloseButton}"
                  Click="OnCloseClick" ToolTip="{loc:Tr 关闭}">
            <!-- ⚠️ 内缩到 1..9（不是 0.5..9.5）：0.5 的端点会让描边占满 0..10，
                 整个图形在 10px 布局盒里偏上 0.5px，实测跟旁边那根横线差 1px。 -->
            <Path Width="10" Height="10" Stretch="None" StrokeThickness="1"
                  Stroke="{Binding Foreground, ElementName=CloseButton}"
                  Data="M1,1 L9,9 M9,1 L1,9" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 原来的两栏内容整体下移一行 -->
    <Grid Grid.Row="1">
      <infra:BackgroundHost x:Name="Backdrop" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="224" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

      <!-- ============================ 侧边栏 ============================ -->
      <Border Grid.Column="0"
              Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="14,20,14,18">

          <!-- 品牌名已挪到顶部标题栏（见 TitleBar 里的 BrandText）。
               这里不再重复一份 —— 否则同一屏会出现两个「⛏ Mosslight」。 -->

          <!-- 导航项由代码建（图标 + 文案要拼在一起，而且文案要过 tr()） -->
          <StackPanel DockPanel.Dock="Top" x:Name="NavList" Margin="0,20,0,0" />

          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="AccountSectionLabel" Style="{StaticResource ShellSectionLabel}" />

            <Button x:Name="AccountChip" Style="{StaticResource ShellAccountChip}"
                    Margin="0,6,0,0" Click="OnAccountChipClick">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ShellAvatarCircle}">
                  <Grid>
                    <!-- 首字母占位：读不出皮肤时显示它（= 1.0.0 的退回行为） -->
                    <TextBlock x:Name="AvatarText" Style="{StaticResource ShellAvatarText}" />
                    <!-- 皮肤头像：从 64×64 皮肤里抠 (8,8) 那块脸放大（见 PlayerAvatars）。
                         ⚠️ 最近邻放大：8×8 是像素画，平滑放大会糊成一团。 -->
                    <Image x:Name="AvatarImage" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True" />
                  </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="AccountNameText" Style="{StaticResource ShellAccountName}" />
                  <TextBlock x:Name="AccountTypeText" Style="{StaticResource ShellAccountType}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="&#x203A;" Style="{StaticResource ShellAccountChevron}" />
              </Grid>
            </Button>

            <TextBlock x:Name="VersionText" Style="{StaticResource ShellVersionText}" Margin="0,12,0,0" />
          </StackPanel>

          <!-- 占位：把上面的 Top/Bottom 顶开，中间的空白留给它们 -->
          <Border />
        </DockPanel>
      </Border>

      <!-- ============================ 页面 ============================
           先垫一条"顶部渐隐底衬"，再放页面本体（顺序就是 z 序：底衬在页面**下面**，
           所以它只压背景图，不压标题文字）。

           为什么要有它：背景图想保原色（蒙层设 0）时，页面标题/副标题就直接压在图上，
           浅色主题下深色字在花背景上很难读（用户 2026-10 报的）。
           与其给整张图盖一层，不如只在标题那一小条把图"收"进页面色、往下淡出到透明 ——
           标题能读，下面 90% 的图还是原样。

           ⚠️ 淡出用 `OpacityMask`（白→透明）而不是让渐变去插值主题色：
              这样只需要一个 `{DynamicResource BgPageBrush}`，换主题自动跟着变，
              也不会出现"深色页面色和透明白插值出来的半透明灰"那种脏色。
           ⚠️ 没有背景图时完全看不出来：那时页面底色本来就是 BgPageBrush，同色叠同色。
           ⚠️ `IsHitTestVisible=False`：这层只负责看，不能挡住页面上的点击。 -->
      <Border Grid.Column="1" Height="118" VerticalAlignment="Top"
              Background="{DynamicResource BgPageBrush}"
              IsHitTestVisible="False">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFFFFFFF" />
            <GradientStop Offset="0.62" Color="#66FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>

      <ContentControl Grid.Column="1" x:Name="PageHost" />
      </Grid>
    </Grid>

    <!-- ============================ 浮层提示（toast） ============================
         收藏 / 下载之类"点一下就该消失"的反馈走这里：**浮在内容上面**、动画进出、
         几秒后自己走，不占布局。以前是把一句话塞进页面的流里（NoticeBanner），
         结果页面被顶下去一块、而且它一直赖在那儿（用户 2026-10：这是提示框吧，
         怎么直接丢页里了？）。

         ⚠️ `IsHitTestVisible=False` 整层不挡鼠标：它只是浮在上面看的。
         ⚠️ 位置：**右下角**，新的压在下面、旧的被顶上去（`StackPanel` 底部对齐
            自然就是这个效果，不用手工插入顺序）。不选右上角是因为那儿正好是
            页面标题和右上角按钮的位置，弹一次挡住一次。
         ⚠️ 底部那 20px 是给窗口边缘留的气，别贴着边。 -->
    <Grid x:Name="ToastHost" IsHitTestVisible="False" Grid.RowSpan="2"
          VerticalAlignment="Bottom" HorizontalAlignment="Right"
          Margin="0,0,20,20" MaxWidth="420">
      <StackPanel x:Name="ToastStack" />
    </Grid>
  </Grid>
</Window>
