<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mosslight Launcher 2.0 —— WPF 界面层

    ## 为什么一个 NuGet 都不引
    开发这台机器连不上 api.nuget.org，引了包就编译不过。所以：
    MVVM 框架、图标库、Json 库全都不用（System.Text.Json 是框架自带的）。
    真要引包，得先解决源的问题，别偷偷加个 PackageReference 让 CI 红掉。

    ## 界面风格
    照搬 1.0.0（PyQt6 那版）。主题色不是手抄的，由
    `D:\deepseek\.dhml-tests\gen_theme_xaml.py` 从 `core/theme.py` 生成
    `Themes\Theme.Dark.xaml` / `Theme.Light.xaml`，运行时再由
    `Infrastructure\ThemeApplier.cs` 覆盖（为了支持自定义强调色和换主题）。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mosslight.App</RootNamespace>
    <AssemblyName>Mosslight</AssemblyName>
    <!-- ⚠️ 版本号**不在这里写**：它在仓库根的 `Directory.Build.props`（只维护一处）。
         写在这儿会盖掉它 —— 结果就是 exe 属性一个版本、界面另一个版本，
         正是 2026-10 用户截图里看到的"界面 v2.0.0-alpha / 属性 2.0.0"那种错位。 -->
    <Product>Mosslight Launcher</Product>
    <Company>Mosslight</Company>
    <Copyright>Copyright © Mosslight</Copyright>
    <!-- 中文界面：不要走"不变文化"，否则排序/大小写会跟平时不一样 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      程序图标。**多尺寸**的一张 ico（32/64/128/256 四帧）——
      1.0.0 那边是把四张单尺寸图 addFile 进同一个 QIcon 让 Qt 按 DPI 挑，
      WPF 只吃一个 .ico 文件，所以在生成阶段就合起来（见
      `D:\deepseek\.dhml-tests\make_multisize_ico.py`）。
      只塞一张 128 的话，任务栏 32px 和 150% 缩放下的 48px 都是缩放出来的，会糊。
    -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 发布形态（正式打包时才用，平时 build 不受影响） -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ⚠️ 这里**故意没有** `Assets\lang\*.json` 的复制项了。

      以前是 <None Update="Assets\lang\*.json"> + CopyToOutputDirectory，
      于是发布包里必须"exe + Assets\ 目录"一起给。现在语言文件归
      Mosslight.Core 管、并且 <EmbeddedResource> 进了程序集
      （见 Mosslight.Core.csproj），发布产物顶层**只有 Mosslight.exe 一个文件**。

      用户仍然能改翻译：Localizer 是"exe 旁边的 Assets\lang\xx.json 优先、
      没有就用内嵌那份"两层加载 —— 界面层不用为这件事做任何事，
      那个目录存在与否都不影响启动。
    -->

    <!-- 图标同时作为 WPF 资源编进去，窗口的 Icon 属性要用（ApplicationIcon 只管 exe 本身） -->
    <Resource Include="Assets\app.ico" />
    <!-- 更新弹窗的固定文案（只有标题/按钮/提示语；更新日志正文不在这里）。
         发布包只有一个 exe，所以必须**嵌进程序集**，不能靠 Assets 目录跟着走。 -->
    <EmbeddedResource Include="Assets\update\lang.json" />

    <!--
      1.0.0 那套图标整包搬过来（`D:\开发工程\DHML-src\assets\icons`）。
      标成 Resource 而不是 Content：XAML 里能直接用 pack URI
      （`/Assets/icons/version/vanilla.png`）引到，不用在 csproj 里一条条列，
      也不会在输出目录里散出一堆 png。
        version\*.png  版本类型图（256×256 等距渲染的方块），版本行左边那个方块就是它
        *.svg/*.ico    动作图标与程序图标（多尺寸 ICO）

      ⚠️ 皮肤（`skins\*.png`）**不在**这一组里，见下面那条：它们要能被
         控制台宿主（自检）读到，而 pack URI 那套只有 Application 起来才可用。
    -->
    <Resource Include="Assets\icons\**" Exclude="Assets\icons\skins\**" />

    <!--
      「关于 / 特别鸣谢」的头像（`Views/Credits.cs` 里按文件名引用）。

      ⚠️ 只收 `*.png`，不收整个目录：那里还放着一份说明用的 README，打进资源没意义。
      ⚠️ 这个目录**可以是空的**（名单先搭结构、图后补）—— 通配符没匹配到文件不算错，
         `AboutDialog.BuildAvatar` 那边会走"圆底 + 首字母"兜底。
    -->
    <Resource Include="Assets\credits\*.png" />

    <!--
      头像皮肤：内嵌成**清单资源**（不是 XAML 的 Resource）。

      为什么要跟别的图标分开：`PlayerAvatars` 在**自检宿主（控制台）**里也要能
      读图，而 `pack://` 资源那套是 WPF 的 Application 起来时才注册的，
      控制台里读一张都读不出来（头像全退回名字首字母）—— 界面里却一切正常，
      这种"只在自检里现形"的差异，不会有人从界面上发现。
      读法见 `PlayerAvatars.LoadEmbedded`（按后缀匹配资源名，不硬编码前缀）。
    -->
    <EmbeddedResource Include="Assets\icons\skins\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mosslight.Core\Mosslight.Core.csproj" />
  </ItemGroup>

</Project>
