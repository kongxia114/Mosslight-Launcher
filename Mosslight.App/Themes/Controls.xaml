    <Style x:Key="BadgePack" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource PackBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PackBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource PackTextBrush}" />
        <Setter Property="TextBlock.FontSize" Value="13" />
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 有版本类型图时的方块：透明底，让图自己说话 -->
    <Style x:Key="BadgeIcon" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 卡片里的一条细分隔线。
         ⚠️ 它是 1px 高的**独立元素**，所以别把它贴在一个容器的最后一行当"下划线"：
            父级位置带小数时 UseLayoutRounding 会把它舍成 0 高（动效设置对话框上实测过）。
            要"某个元素带一条下边线"，请用那个元素自己的 BorderThickness（见 DialogTitle）。 -->
    <Style x:Key="CardSep" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 加载状态条的外框 -->
    <Style x:Key="LoadingBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="LoadingBarText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 预览区：比卡片底再深一层（页面色），示意卡片才浮得出来 -->
    <Style x:Key="PreviewBox" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource BgWindowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 下载窗口里的文件行（#DownloadRow 也在 card_style.py 的 CARD_SELECTORS 里） -->
    <Style x:Key="DownloadRow" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 当前档案左边那根竖条（宽度由页面给；非当前的行用 AccentOff 占位对齐） -->
    <Style x:Key="AccountRowAccent" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style x:Key="AccountRowAccentOff" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>


    <!-- ==========================================================================================
         三、按钮
         隐式 Style（不带 x:Key 的那个）会自动套到所有 Button 上，对应 QSS 里的裸 `QPushButton`。
         每个变体都必须自带一份 ControlTemplate：WPF 里 Template 是整体替换的，
         继承基类的 Template 会把基类的 hover / pressed 配色一起继承过来。
         ⚠️ QSS 没给按钮设 cursor，Qt 按钮默认就是箭头，所以这里也**故意不设** Cursor。
         ========================================================================================== -->

    <Style x:Key="BaseButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- padding: 7px 16px -->
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BaseScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="Glow" ShadowDepth="0" BlurRadius="0"
                                              Opacity="0" Color="{DynamicResource Accent}" />
                        </Border.Effect>
                        <Grid>
                            <Border x:Name="HoverLayer" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource BgHoverBrush}" />
                            <Border x:Name="PressLayer" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource BgPressedBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        日志窗口那排级别计数按钮的底子。

        ⚠️ 它**不能** BasedOn `BaseButton`：那个 Style 的 TargetType 是 Button，
           而 ToggleButton 跟 Button 是**兄弟**（都继承 ButtonBase），不是父子 ——
           WPF 会直接抛"只能根据带有基类型 ToggleButton 的目标类型的 Style"，
           而且是**运行时**才抛（编译能过），表现就是窗口一开就崩。
           所以这里单独写一份 TargetType=ToggleButton 的模板，形状跟 BaseButton 一致。
    -->
    <Style x:Key="BaseToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 裸 QPushButton 的等价物：所有没写 Style 的按钮自动长这样 -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}" />

    <!-- 主操作按钮（绿色实心） -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
        <!-- 微交互：悬停放大 1.5%、按下缩到 96%（只动 RenderTransform，不重排） -->
        <Setter Property="infra:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="infra:HoverLift.IsEnabled" Value="True" />
        <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BaseScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="Glow" ShadowDepth="0" BlurRadius="0"
                                              Opacity="0" Color="{DynamicResource Accent}" />
                        </Border.Effect>
                        <Grid>
                            <Border x:Name="HoverLayer" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource AccentFillHoverBrush}" />
                            <Border x:Name="PressLayer" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource AccentFillPressedBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险操作（删除）：平时是描边红字，悬停才铺红底 -->
    <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBgHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按钮（"查看来源网站"这类不该抢主操作注意力的）。
         ⚠️ 这里按 QSS 的**实际**写法翻：40-about-log.qss 的 #LinkButton 是
         「透明底 + 细边框 + 次要文字色」，悬停变浮起底 + 强调色描边 + 强调色文字。
         **没有**下划线（任务表里写的「hover 下划线」与 QSS 不符，以 QSS 为准）。
         宿主叫它 GhostButton，两个键名等价，改一份就行。 -->
    <Style x:Key="LinkButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <!-- padding: 5px 12px -->
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 宿主约定的别名 -->
    <Style x:Key="GhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource LinkButton}" />

    <!-- ============================================================
         独立日志窗口（LogWindow）

         照 1.0.0 `assets/styles/parts/40-about-log.qss` 那一段：
         `#LogCountFatal/Error/Warn/Info/Debug` 是**既是计数也是过滤开关**的按钮 ——
         点一下把那一级藏起来（按钮弹起、文字压暗），再点一下放出来。
         所以它们的外观被压成"文字标签"的样子：透明底、无边框、只有文字颜色。
         ============================================================ -->
    <Style x:Key="LogLevelToggle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaseToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
                        </Trigger>
                        <!-- 点掉的级别：压暗 + 去掉加粗，一眼看出"这一级现在不显示" -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter Property="FontWeight" Value="Normal" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日志窗口的日志正文：底色走 bg_window、圆角 8、等宽 12px（QSS 的 #GameLog）。
         ⚠️ 不能 BasedOn BaseTextBox：那个 Style 的 TargetType 是 TextBox，
            RichTextBox 跟它没有继承关系，套上去会直接在启动时报
            "Style 的目标类型不匹配"。所以这里自己写一份完整模板。 -->
    <Style x:Key="GameLogRichTextBox" TargetType="{x:Type RichTextBox}">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New, monospace" />
        <Setter Property="FontSize" Value="12" />
        <!-- ⚠️ 正文色用 TextBright 而不是 TextDim：每行的实际颜色是写进 Run 的
             （见 LogWindow 的 LevelColors），这里的 Foreground 只兜底 ——
             但 QSS 那边 `#GameLog` 给的 @text_dim@ 是给"整块控件"的亮度，
             一行一行分开看时明显偏暗（实机截图上 INFO 那几行几乎糊在底色里）。
             C# 这边按"一行一行看"的实际需要提亮一档。 -->
        <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgWindowBrush}" />
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectBgBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- 关掉拼写检查之类：几万行的文档开着它们会卡 -->
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RichTextBox}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 无边框的图标按钮 -->
    <Style x:Key="IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BaseScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="Glow" ShadowDepth="0" BlurRadius="0"
                                              Opacity="0" Color="{DynamicResource Accent}" />
                        </Border.Effect>
                        <Grid>
                            <Border x:Name="HoverLayer" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource BgControlBrush}" />
                            <Border x:Name="PressLayer" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource BgCardBrush}" />
                        <ContentPresenter
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True">                        </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="BaseScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.09"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 首页的启动按钮。⚠️ QSS 里它其实是个 QFrame（两行文字自己拼），
         所以**没有** padding：宽高由页面给死。 -->
    <Style x:Key="LaunchButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
        <!-- 大按钮悬停时轻微放大，手感更"活" -->
        <Setter Property="infra:HoverLift.IsEnabled" Value="True" />
        <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 运行中的「停止游戏」按钮：形状跟 LaunchButton 一样，配色换成危险色 -->
    <Style x:Key="StopButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
        <!-- 大按钮悬停时轻微放大，手感更"活" -->
        <Setter Property="infra:HoverLift.IsEnabled" Value="True" />
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBgBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 启动面板上那排次要按钮：只有 padding / 字号跟基础按钮不同 -->
    <Style x:Key="PanelButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
        <!-- padding: 10px 16px -->
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="13" />
    </Style>


    <!-- ==========================================================================================
         四、可勾选按钮（ToggleButton）
         QSS 的 `:checked` → WPF 的 IsChecked=True。
         ========================================================================================== -->

    <!-- 侧边栏导航项。
         ⚠️ 选中态的配色取 QSS 的 `#NavButton:checked { background-color: @bg_elevated@;
         color: @accent@; font-weight: bold }`，也就是「浮起底 + 强调色文字」。
         宿主契约里写的是 AccentBgBrush / AccentTextBrush —— 以 QSS 为准；
         真要换成淡绿底请改这里的两个 Setter，别改键名。 -->
    <Style x:Key="NavButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <!-- padding: 10px 12px -->
        <Setter Property="Padding" Value="12,10" />
        <!-- text-align: left -->
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <!-- 放在 hover 后面：Qt 里 :checked 也是后定义的规则赢 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 宿主约定的别名 -->
    <Style x:Key="NavItemButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource NavButton}" />

    <!-- 版本设置页顶部的两个 tab：选中项靠"下划线"而不是另一块底色。
         QSS 的 `border-bottom` 在 WPF 里就是一条 0,0,0,2 的 BorderThickness。 -->
    <Style x:Key="TabButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <!-- padding: 8px 14px 6px 14px -->
        <Setter Property="Padding" Value="14,8,14,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 可收起区块的标题开关。
         ⚠️ #SectionToggle 被定义了两次：60-dialogs.qss 给了"卡片外观"，70-version-settings.qss
         后来把它改成"看着像小标题的扁平按钮"。parts 按文件名排序加载、后者覆盖前者，
         所以**最终生效的是扁平那版**，这里照最终效果翻。
         （被覆盖掉的 60-dialogs 版本里 `:checked` 只有 border-color 变化，而 border 已经被
         `border: none` 关掉了 —— 也就是说这个开关的勾选态在界面上**没有任何视觉反馈**，
         这是 QSS 的原样，不是这里漏翻。） -->
    <Style x:Key="SectionToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <!-- padding: 4px 0 -->
        <Setter Property="Padding" Value="0,4" />
        <!-- text-align: left -->
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="0">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================================
         五、文本输入
         WPF 的 TextBox / PasswordBox 默认模板带系统底和凹陷边框，必须整份换掉。
         PART_ContentHost 是这两个控件的硬约定名，改了就不显示文字。
         ========================================================================================== -->

    <Style x:Key="BaseTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- padding: 7px 10px -->
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <!-- selection-background-color / selection-color -->
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectBgBrush}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <!-- 内容宿主必须叫 PART_ContentHost。滚动条可见性要跟着控件走，
                             写死 Hidden 的话多行文本框就滚不动了。 -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- 单行时把文字竖直居中（Qt 的 QLineEdit 就是这么画的）；
                             多行时撑满，否则滚动区域只有一行高 -->
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch" />
                        </Trigger>
                        <!-- 放最后：禁用态在 Qt 里不吃 hover / focus -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgDisabledBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseTextBox}" />

    <!--
      QSpinBox 的上下箭头按钮（20-inputs.qss 的 QSpinBox::up-button / down-button）。

      ⚠️ 这是那份「没翻的 QSS 选择器清单」里原来记着"留给宿主自行实现"的一条。
         WPF 没有内建 NumericUpDown，宿主补了一个 `Views/NumberBox`（数字框本体在那边，
         输入校验和步进是行为，塞不进样式表），这里只翻**按钮外观**：
             width: 22px / border: none / background: transparent
             :hover → background-color: border_control + border-radius: 4px
         箭头本身是 SVG，按本工程一贯做法用 Path 画 chevron（见滚动条那一节）。
    -->
    <Style x:Key="NumberBoxArrowButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource BorderControlBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 多行 / 等宽：安装器控制台（#DownloadConsole）和游戏日志（#GameLog）。
         QSS 里这两条各自设了等宽字体，底色一个走 bg_control 一个走 bg_window。 -->
    <Style x:Key="ConsoleTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseTextBox}">
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="GameLogTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseTextBox}">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New, monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgWindowBrush}" />
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- 密码框：QSS 没有单独写规则（它也是 QLineEdit），所以外观跟输入框一致 -->
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectBgBrush}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgDisabledBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================================
         六、下拉框
         QComboBox 的硬约定：PART_Popup（弹层）+ 一个和 IsDropDownOpen 双向绑定的 ToggleButton。
         这里只做**不可编辑**的下拉，QSS 也没有为可编辑态写过样式。
         ========================================================================================== -->

    <!-- 弹层里的一项：padding 6px 8px / 圆角 6 / min-height 22 -->
    <Style x:Key="ComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <!-- 对应 QSS 的 `outline: none` -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                        </Trigger>
                        <!-- selection-background-color / selection-color -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectedBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelectedBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- padding: 7px 10px -->
        <Setter Property="Padding" Value="10,7" />
        <!-- min-height: 20px（内容）+ padding 7*2 + 边框 2 -->
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <!-- QComboBox::drop-down 的 width: 30px -->
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False" />
                                <!-- 可编辑态（`IsEditable="True"`，目前只有下载页的「版本」用它）：
                                     WPF 的可输入 ComboBox 认的就是**这个名字**的 TextBox ——
                                     模板里没有它的话，`IsEditable` 设了也不会显示任何文字，
                                     框里永远是空的（2026-10 踩过：选中项/筛选值都对，就是看着像没选）。
                                     ⚠️ 局部把 Background / BorderThickness / Padding 压掉：
                                        隐式 TextBox 样式（BaseTextBox）会给它加一圈边框。 -->
                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Margin="{TemplateBinding Padding}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         VerticalContentAlignment="Center"
                                         FontFamily="{TemplateBinding FontFamily}"
                                         FontSize="{TemplateBinding FontSize}"
                                         Foreground="{TemplateBinding Foreground}"
                                         Visibility="Collapsed" />
                                <!-- QComboBox::down-arrow 原本是一张 SVG，这里用 Path 画同样的
                                     chevron，免得样式字典依赖图标资源。 -->
                                <Path x:Name="Arrow"
                                      Grid.Column="1"
                                      Data="M 0,0 L 5,5 L 10,0"
                                      Stroke="{DynamicResource TextDimBrush}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <!-- 整块可点区域（模板里内联，不引第三方控件） -->
                        <ToggleButton x:Name="DropDownToggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <!-- QComboBox QAbstractItemView：浮起底 + 边框 + 圆角 8 + padding 4 -->
                            <Border Background="{DynamicResource BgElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderControlBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    Margin="0,2,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <!-- ⚠️ 整块可点层缩到"箭头那一格"（右 30px）：它在外层 Grid 里、
                                 压在 Border 之上，不缩的话会把输入框整个盖住、点不进去。
                                 可编辑态下开下拉就点箭头（跟 PCL 那个版本框一样）。 -->
                            <Setter TargetName="DropDownToggle" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="DropDownToggle" Property="Width" Value="30" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgDisabledBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource TextFaintBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================================
         七、勾选框 / 单选框
         QSS 把两者的 indicator 统一成 "17x17、圆角 4、选中填强调色 + 打勾图"。
         打勾图在 WPF 里用 Path 画（不引图标资源）。
         ========================================================================================== -->

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <!-- padding: 3px -->
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="17"
                                Height="17"
                                CornerRadius="4"
                                Background="{DynamicResource BgCheckBrush}"
                                BorderBrush="{DynamicResource BorderHoverBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Data="M 0,3.5 L 3.5,7 L 9,1"
                                  Stroke="{DynamicResource OnAccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <!-- QCheckBox 的 spacing: 9px -->
                        <ContentPresenter Margin="9,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- 禁用态后置：Qt 里 disabled 会盖掉 checked 的配色 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource BgDisabledBrush}" />
                            <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      拨动开关（1.0.0 的 `ui/widgets/switch.py`，设置页的「使用自定义下载线程数」
      和「其他」那两条都用它）。

      ⚠️ 1.0.0 那边是**自绘控件**，QSS 完全管不到它 —— 颜色从 ui/theme_state.py 现取：
             轨道 40×22，圆角 = 高的一半
             打开：轨道 accent_fill，圆钮 on_accent（白）
             关闭：轨道 border_control，圆钮 text_dim
             禁用：两者都变淡
         WPF 这边没有"QSS 管不到"的问题，所以做成 CheckBox 的一条样式：
         拨动开关的语义就是"勾选"，用 CheckBox 能白拿键盘、自动化、IsChecked 绑定。
         ⚠️ 开关在**左**、文字在**右**（1.0.0 的 `_switch_row`：addWidget(sw) 再 addWidget(label)，
            row.setSpacing(10)），所以 ContentPresenter 的左边距是 10。
    -->
    <Style x:Key="SwitchCheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <!-- 跟 FieldLabel 一致（1.0.0 给这些标签传的是 "FieldLabel"） -->
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track"
                                Width="40"
                                Height="22"
                                CornerRadius="11"
                                Background="{DynamicResource BorderControlBrush}"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <!-- 圆钮直径 18、四周留 2px；打开时往右挪 18px（40-18-2*2） -->
                            <Border x:Name="Knob"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="{DynamicResource TextDimBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="2,0,0,0" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource OnAccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <!-- 禁用态放最后：Qt 里 disabled 会盖掉其余状态 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            <Setter TargetName="Knob" Property="Opacity" Value="0.6" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 单选框在 QSS 里被做成了"整块可点的选项卡"（padding 9px 11px + 选中铺淡绿底） -->
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <!-- padding: 9px 11px -->
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <!--
                              单选点：**圆形**（2026-10 照 PCL 的「内存分配」改的）。
                              ⚠️ 以前这里是方角 Box + 对勾，选中时整行还会被填成强调色底 ——
                                 读起来像"标签按钮"，跟"单选"的语义对不上；PCL 那边是标准圆点。
                            -->
                            <Border x:Name="Box"
                                    Width="17"
                                    Height="17"
                                    CornerRadius="9999"
                                    Background="{DynamicResource BgCheckBrush}"
                                    BorderBrush="{DynamicResource BorderHoverBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Ellipse x:Name="Dot"
                                         Width="7"
                                         Height="7"
                                         Fill="{DynamicResource OnAccentBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                            </Border>
                            <!-- spacing: 9px -->
                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- ⚠️ 只填圆点、不变整行底色：单选要的是"圈里有个点"，不是一块强调色块 -->
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource BgDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================================
         八、滑块
         ⚠️ QSS 里**故意没有**裸 `QSlider` 规则（60-dialogs.qss 的注释写了原因：裸规则会顺带
         改掉个性化页那三个调色滑块），只有 `#SettingSlider` 和 `#MemorySlider`。
         这里仍然给一个隐式 Style（宿主契约要求，且总得有个默认），观感取 #SettingSlider 那套，
         再让两者 BasedOn 它，各自只改不同的部分。
         QSlider 的 `::groove` / `::sub-page` / `::add-page` / `::handle` 在 WPF 里的等价物：
             groove   → 模板里垫在底下的那条 Border
             sub-page → Track.DecreaseRepeatButton（滑块左边，填强调色）
             add-page → Track.IncreaseRepeatButton（右边，透明）
             handle   → Track.Thumb
         PART_Track 是 Slider 的硬约定名，不能改。
         ========================================================================================== -->

    <!-- 已滑过那一段：SettingSlider 用 accent，MemorySlider 用 accent_fill -->
    <Style x:Key="SliderFillButtonAccent" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="Fill"
                            Height="4"
                            CornerRadius="2"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource BorderControlBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFillButtonSoft" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="Fill"
                            Height="8"
                            CornerRadius="4"
                            Background="{DynamicResource AccentFillBrush}"
                            VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource BorderControlBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 未滑过那一段：透明，露出底下的 groove（对应 `add-page { background: none }`） -->
    <Style x:Key="SliderEmptyButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SettingSlider 的滑块：12px 圆点，悬停变浅绿，禁用变灰 -->
    <Style x:Key="SettingSliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Handle"
                            Width="12"
                            Height="12"
                            CornerRadius="6"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Handle" Property="Background" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MemorySlider 的滑块：16px 白心 + 2px 强调色描边（对应 width 16 / border 2 / radius 9） -->
    <Style x:Key="MemorySliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Handle"
                            Width="16"
                            Height="16"
                            CornerRadius="8"
                            Background="{DynamicResource TextBrightBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- Thumb 没有 IsPressed，按住拖动对应 IsDragging -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentFillPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Handle" Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
                            <Setter TargetName="Handle" Property="Background" Value="{DynamicResource BgControlBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 横向滑块模板（SettingSlider 用）：groove 4px，走 @border@ -->
    <ControlTemplate x:Key="SliderHorizontalTemplate" TargetType="{x:Type Slider}">
        <Grid Height="16" VerticalAlignment="Center" Background="Transparent">
            <Border x:Name="Groove"
                    Height="4"
                    CornerRadius="2"
                    Background="{DynamicResource BorderBrush}"
                    VerticalAlignment="Center" />
            <Track x:Name="PART_Track" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButtonAccent}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SettingSliderThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- 纵向滑块模板：QSS 没写过纵向，这里给一个中性版本，纯粹是为了别让竖着放的滑块串味 -->
    <ControlTemplate x:Key="SliderVerticalTemplate" TargetType="{x:Type Slider}">
        <Grid Width="16" HorizontalAlignment="Center" Background="Transparent">
            <Border x:Name="Groove"
                    Width="4"
                    CornerRadius="2"
                    Background="{DynamicResource BorderBrush}"
                    HorizontalAlignment="Center" />
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderEmptyButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SettingSliderThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderFillButtonAccent}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- 内存滑块模板：groove 8px + bg_control 底 + 1px border_control 边，sub-page 用 accent_fill -->
    <ControlTemplate x:Key="MemorySliderHorizontalTemplate" TargetType="{x:Type Slider}">
        <Grid Height="18" VerticalAlignment="Center" Background="Transparent">
            <Border x:Name="Groove"
                    Height="8"
                    CornerRadius="4"
                    Background="{DynamicResource BgControlBrush}"
                    BorderBrush="{DynamicResource BorderControlBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center" />
            <Track x:Name="PART_Track" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButtonSoft}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource MemorySliderThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type Slider}">
        <!-- Qt 点轨道是"翻一页"，WPF 的默认也是翻一页（指到哪跳到哪是 IsMoveToPointEnabled） -->
        <Setter Property="IsMoveToPointEnabled" Value="False" />
        <Setter Property="Template" Value="{StaticResource SliderHorizontalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource SliderVerticalTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 背景设置对话框里那三个滑块（压暗 / 卡片透明度 / 线程数） -->
    <!-- ===== 滑块动效（照着 1.0.0 的 #SettingSlider / #MemorySlider 重画） ===== -->
    <infra:RatioToWidthConverter x:Key="RatioToWidth" />

    <!-- 圆点：悬停 1.14× / 拖拽 1.28×，只缩放 Ellipse；Thumb 自身永远 14×14 → 不重排 -->
    <Style x:Key="SliderThumbMotion" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Dot" Fill="{DynamicResource AccentFillBrush}"
                                 Stroke="{DynamicResource BgPageBrush}" StrokeThickness="2"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="Halo" ShadowDepth="0" BlurRadius="0"
                                                  Opacity="0" Color="{DynamicResource Accent}" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.10"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.14" Duration="0:0:0.10"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.10"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.10"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.28" Duration="0:0:0.10"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.28" Duration="0:0:0.10"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.10"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.65" Duration="0:0:0.10"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.14" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="BlurRadius" To="10" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.12"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SliderMotionTemplate" TargetType="{x:Type Slider}">
        <Grid Background="Transparent">
            <Border x:Name="TrackBg" Height="6" CornerRadius="3" VerticalAlignment="Center"
                    Background="{DynamicResource BgControlBrush}" />
            <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" BorderThickness="0">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Height="6" CornerRadius="3"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" BorderThickness="0">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Height="6" Background="Transparent" />
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SliderThumbMotion}" />
                </Track.Thumb>
            </Track>
            <Border x:Name="WarningZone" Height="6" CornerRadius="3" Opacity="0.55"
                    IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{DynamicResource WarnBrush}">
                <Border.Width>
                    <MultiBinding Converter="{StaticResource RatioToWidth}">
                        <Binding Path="(infra:SliderExtras.WarningRatio)"
                                 RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                </Border.Width>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackBg" Property="Background" Value="{DynamicResource BgHoverBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="SettingSlider" TargetType="{x:Type Slider}" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Height" Value="24" />
        <!-- 填充色跟着 Foreground 走；越过安全线时页面把它换成 WarnBrush -->
        <Setter Property="Foreground" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template" Value="{StaticResource SliderMotionTemplate}" />
    </Style>

    <!-- 内存滑块：设置页的主角，轨道更粗、滑块更大 -->
    <Style x:Key="MemorySlider" TargetType="{x:Type Slider}" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Height" Value="24" />
        <!-- 填充色跟着 Foreground 走；越过安全线时页面把它换成 WarnBrush -->
        <Setter Property="Foreground" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template" Value="{StaticResource SliderMotionTemplate}" />
        <!-- 最右 40% 是"越过安全线"的黄区（物理内存 60% 那条） -->
        <Setter Property="infra:SliderExtras.WarningRatio" Value="0.4" />
    </Style>


    <!--
 设计说明见 docs/design-notes.md#mosslight-app-themes-controls-xaml
-->

    <Style x:Key="ScrollBarThumbVertical" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <!-- min-height: 30px -->
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <!-- 左右各留 2px：handle 比轨道窄一点，两边能看到轨道底色 -->
                    <Border x:Name="Bd"
                            Margin="2,0,2,0"
                            CornerRadius="5"
                            Background="{DynamicResource BorderControlBrush}"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumbHorizontal" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <!-- min-width: 30px -->
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bd"
                            Margin="0,2,0,2"
                            CornerRadius="5"
                            Background="{DynamicResource BorderControlBrush}"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 轨道空白处：QSS 的 `add-page / sub-page { background: none }` -->
    <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 箭头按钮：透明底，悬停给一块淡底（QSS 的 `:hover { background: @bg_elevated@ }`） -->
    <Style x:Key="ScrollBarArrowUp" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                        <Path x:Name="Glyph"
                              Data="M 0,4 L 4,0 L 8,4"
                              Stroke="{DynamicResource TextFaintBrush}"
                              StrokeThickness="1.4"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- QSS 的 `:disabled { image: none }` -->
                            <Setter TargetName="Glyph" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下 / 右 / 左三个方向靠旋转复用上面的箭头 -->
    <Style x:Key="ScrollBarArrowDown" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource ScrollBarArrowUp}">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <RotateTransform Angle="180" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarArrowRight" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource ScrollBarArrowUp}">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <RotateTransform Angle="90" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarArrowLeft" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource ScrollBarArrowUp}">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <RotateTransform Angle="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent" Margin="0,2,0,2">
            <Grid.RowDefinitions>
                <!-- height: 16px -->
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
            </Grid.RowDefinitions>
            <RepeatButton Grid.Row="0" Style="{StaticResource ScrollBarArrowUp}" Command="ScrollBar.LineUpCommand" />
            <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbVertical}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Style="{StaticResource ScrollBarArrowDown}" Command="ScrollBar.LineDownCommand" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent" Margin="2,0,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <RepeatButton Grid.Column="0" Style="{StaticResource ScrollBarArrowLeft}" Command="ScrollBar.LineLeftCommand" />
            <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbHorizontal}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Style="{StaticResource ScrollBarArrowRight}" Command="ScrollBar.LineRightCommand" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <!-- QScrollBar:vertical 的 width: 10px -->
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <!-- QScrollBar:horizontal 的 height: 10px -->
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ==========================================================================================
         十、滚动区域
         QSS 里 `QScrollArea { background-color: transparent; border: none }`，加上
         `QScrollArea 内层 QWidget { background: transparent }`（30-badges.qss）。
         WPF 的 ScrollViewer 默认就带一个浅色边框，所以这里显式换成"透明 + 无边框"。
         ⚠️ 隐式样式会把默认模板顶掉，所以下面这份模板必须完整：
         PART_ScrollContentPresenter / PART_VerticalScrollBar / PART_HorizontalScrollBar 三个名字
         一个都不能少，少了滚动就废了。
         纵向默认 Auto（Qt 的 QScrollArea 也是"需要才出"），横向沿用 WPF 的默认 Disabled。
         ========================================================================================== -->

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Orientation="Vertical"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Cursor="Arrow"
                                   IsTabStop="False" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Orientation="Horizontal"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Cursor="Arrow"
                                   IsTabStop="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================================
         十一、列表
         `QListWidget::item` 一类的规则在 WPF 里对应 ListBoxItem 的容器样式。
         同样地，隐式 ListBox / ListBoxItem 都**必须自带 Template**。
         ========================================================================================== -->

    <!-- 通用行：QListWidget::item（padding 9px 10px / 圆角 8 / 下边距 2 / 悬停与选中都用浮起色） -->
    <ControlTemplate x:Key="ListRowTemplate" TargetType="{x:Type ListBoxItem}">
        <Border x:Name="Bd"
                Margin="0,0,0,2"
                Background="Transparent"
                CornerRadius="8"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="10,9" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 版本列表的整行卡片：圆角 10 / 上下边距 2 / 选中铺 accent_bg + accent_border。
         悬停底走 CardHoverBrush（#VersionList::item:hover 在 card_style.py 的 HOVER_SELECTORS 里）。 -->
    <ControlTemplate x:Key="VersionRowTemplate" TargetType="{x:Type ListBoxItem}">
        <Border x:Name="Bd"
                Margin="0,2,0,2"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="10"
                SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                <!-- 悬停描边用强调色：card_style.py 的 HOVER_SELECTORS 里
                     `#VersionList::item:hover` 就是 background=bg_elevated@alpha + border=accent -->
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBgBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 账户列表的整行卡片：形状同上，但选中用**中性灰** —— 绿色专门留给"当前档案"，
         不然绿色的选中底比"当前"那根细竖条显眼得多，会让人误以为选中的那行才是当前档案。 -->
    <ControlTemplate x:Key="AccountRowTemplate" TargetType="{x:Type ListBoxItem}">
        <Border x:Name="Bd"
                Margin="0,2,0,2"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="10"
                SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderSelectedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ListItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <!-- outline: none —— 去掉 WPF 的焦点虚线框，跟 QSS 一致 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{StaticResource ListRowTemplate}" />
    </Style>

    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListItem}" />

    <Style x:Key="VersionListItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListItem}">
        <Setter Property="Template" Value="{StaticResource VersionRowTemplate}" />
    </Style>

    <!-- 版本列表里的**分组标题**行（「官方版本    2」）。
         ⚠️ 不能直接套 VersionListItem：它自带 `Margin="0,2,0,2"`（那是版本行之间的
            缝），套到 36 高的分组标题上会把内容区压成 32，而标题自己的 14px 上边距
            （VersionGroupTitle 的 Margin）就溢出了 —— 表现是标题贴着上一行、间距全错。
            所以分组标题要一个**没有内边距**的模板，高度靠 VersionGroupTitle 的
            Margin 撑（14 + 12px 字 + 6 = 36，正好是 1.0.0 的 setSizeHint(QSize(0, 36))）。 -->
    <ControlTemplate x:Key="VersionGroupRowTemplate" TargetType="{x:Type ListBoxItem}">
        <ContentPresenter />
    </ControlTemplate>

    <Style x:Key="VersionGroupItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListItem}">
        <Setter Property="Template" Value="{StaticResource VersionGroupRowTemplate}" />
        <Setter Property="Height" Value="36" />
    </Style>

    <Style x:Key="AccountListItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListItem}">
        <Setter Property="Template" Value="{StaticResource AccountRowTemplate}" />
    </Style>

    <Style x:Key="BaseListBox" TargetType="{x:Type ListBox}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <!-- QListWidget：透明底、无边框 -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListItem}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False"
                                      Padding="0"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter SnapsToDevicePixels="True" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource BaseListBox}" />

    <Style x:Key="VersionList" TargetType="{x:Type ListBox}" BasedOn="{StaticResource BaseListBox}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource VersionListItem}" />
    </Style>

    <Style x:Key="AccountList" TargetType="{x:Type ListBox}" BasedOn="{StaticResource BaseListBox}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource AccountListItem}" />
    </Style>


    <!-- ==========================================================================================
         十一之二、社区资源卡（#ModCard 一族）
         照 1.0.0 的 `parts/80-mods.qss` 翻。

         ⚠️ 位置有讲究：**必须排在十一（列表）后面**。它里面的 ModCardRow 是
            `BasedOn="{StaticResource ListItem}"`，而 StaticResource **只往回找** ——
            放在列表那节前面会在运行时炸"无法找到名为 ListItem 的资源"
            （编译期查不出来，只有真开程序才现形）。

         ⚠️ 圆角是 10（不是 Card 的 12）：1.0.0 的搜索结果卡就是 10，
            比页面卡片小一号 —— 卡片套卡片时里层圆角小于外层才看得出层次。
         ⚠️ 底色/描边走 **CardSurfaceBrush / CardBorderBrush**，不是 BgCardBrush：
            card_style.py 的 CARD_SELECTORS 里有 #ModCard，所以它要跟着"卡片透明度"一起变
            （这条在文件末尾那份"没翻的 QSS 清单"里专门点过名）。
         ========================================================================================== -->

    <!-- 卡片本体。hover 换浮起底 + 强调色描边（= #ModCard:hover） -->
    <Style x:Key="ModCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <!-- QSS 的 padding: 12px（图标和文字之间的 14 由页面里的 Margin 表达） -->
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 卡片里的每个文字块都是**透明底**（#ModCard QLabel 那条规则）：
         不透明会盖住卡片自己的底色，hover 时只有卡片边缘变色、中间还是旧的。 -->
    <Style x:Key="ModCardText" TargetType="{x:Type TextBlock}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 项目名：14px 加粗提亮 -->
    <Style x:Key="ModCardName" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModCardText}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 作者：11px，最淡的一档 -->
    <Style x:Key="ModCardAuthor" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModCardText}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 简介：12px 中灰、**自动换行**。最多两行由页面的 ModTextLines.Clamp 夹
         （1.0.0 那边靠卡片的 96px 固定高度顺带夹住；WPF 这边卡片高度自适应，
           所以得自己按"文本自己算出来的行高"夹）。 -->
    <Style x:Key="ModCardDesc" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModCardText}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 底部那一行元信息（支持版本数 / 下载量 / 关注数）：11px，最淡的一档 -->
    <Style x:Key="ModCardMeta" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModCardText}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 结果卡**行尾那个「›」**：卡片上唯一的"点得开、里面还有一层"的提示。
         2026-10 列表卡右侧那个绿色「安装」按钮删掉之后补的 —— 不补的话行尾空一大块，
         整张卡看着不像能点（详情页才是选版本 / 下载的地方）。
         ⚠️ 三条边界，别再往回改：
            · 它**不是按钮**：不参与交互、不抢焦点、不占强调色 —— Hover 才是卡片
              "能点"的主要信号（见上面 ModCard 的 IsMouseOver 触发器）；
            · 颜色只用到"中灰"（TextDimBrush，跟简介同一档），比元信息亮一档是为了
              在深色底上真的看得见（最淡那档 11px 实测几乎是不可见的一个点）；
            · 它是个**符号**，不需要翻译 —— 换成"点开选版本"这种小字，
              5 个语言文件里就多一条只有中文的文案。 -->
    <Style x:Key="ModCardChevron" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModCardText}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <!-- 比正文大一档：指向符是图形不是文字，跟 12px 的简介同号会显得像标点 -->
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ⚠️ 图标占位方块：**画在 Image 后面**，尺寸/圆角和图一模一样 ——
         图没下来、下载失败、url 为空时它露出来，永远不会有空白洞。
         1.0.0 那边的占位是个"?"字（图标还没搬全时的做法），这里用
         "底块 + 内置兜底方块图"（`Assets\icons\version\` 那批），信息量比问号大。
         `Clip` 由代码按圆角 8 给一个圆角矩形（WPF 的 Border 不裁子元素）。 -->
    <Style x:Key="ModCardIconWell" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 项目类型徽章（模组 / 整合包 / 数据包 …）：比 Badge 小一号、方角一点。
         1.0.0 走的是 #ModTypeBadge（bg_control + border_control + 圆角 4 + 10px 字），
         **不是** BadgeAccent —— 类型徽章和加载器徽章在卡片上要一眼分得开。 -->
    <Style x:Key="ModTypeBadge" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <!-- QSS 的 padding: 1px 6px -->
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextBlock.FontSize" Value="10" />
        <Setter Property="TextBlock.FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 搜索结果行的容器（ListBoxItem）：模板只留一个 ContentPresenter ——
         卡片自己画底色和描边，容器再画一层会在 hover 时出现"两个框"。 -->
    <ControlTemplate x:Key="ModCardRowTemplate" TargetType="{x:Type ListBoxItem}">
        <ContentPresenter />
    </ControlTemplate>

    <Style x:Key="ModCardRow" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListItem}">
        <Setter Property="Template" Value="{StaticResource ModCardRowTemplate}" />
        <!-- 卡片自带 12 的内边距，容器别再撑高（行间距由页面给卡片设的 Margin 出） -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>


    <!-- ==========================================================================================
         十二、进度条 / 提示气泡
         QProgressBar 不写 ::chunk 的话在 Windows 上会画成系统原生方块条（30-badges.qss 的注释），
         WPF 同理：必须换掉模板，用 PART_Indicator 画强调色块。这两个 PART 名是硬约定。
         ========================================================================================== -->

    <Style x:Key="BaseProgressBar" TargetType="{x:Type ProgressBar}">
        <!-- #LoadingBarTrack / #DownloadBar 都是 6px 高、圆角 3 -->
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" />
                            <Rectangle x:Name="PART_Indicator"
                                       Fill="{TemplateBinding Foreground}"
                                       RadiusX="3"
                                       RadiusY="3"
                                       HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource BaseProgressBar}" />

    <!-- #DownloadBarTotal：只是更高一档（QSS 里圆角是 5，这里沿用 3，肉眼分不出来） -->
    <Style x:Key="DownloadBarTotal" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource BaseProgressBar}">
        <Setter Property="Height" Value="10" />
    </Style>

    <!-- QToolTip：底色走 bg_control、6px 圆角、padding 6px 10px。
         QSS 没有投影，所以 HasDropShadow 关掉。 -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- padding: 6px 10px -->
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================================
         十三、下载页：分类栏 / 折叠组 / 版本行
         照 1.0.0 的 `parts/30-badges.qss` 那一段翻。色值一个都不在这里写死。
         ========================================================================================== -->

    <!-- 下载页左侧的分类栏。
         ⚠️ QSS 里它叫 #DownloadNavCard 而不是 #Card：它是**外壳**不是内容卡片 ——
            设了背景图时它要跟着左侧竖栏一起半透明（card_style.py 的 chrome_stylesheet），
            沿用 #Card 会跟别的卡片一起被"卡片透明度"带走。外观跟 Card 一致，所以直接 BasedOn。 -->
    <Style x:Key="DownloadNavCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}" />

    <!-- 分类栏里的分组标题（版本 / 社区资源 / 安装包）。17px 加粗 —— 
         ⚠️ 字号必须写在这里：它挂在 TextBlock 上，页面里再设一次 FontSize 也行，
            但两边不一致时以样式为准，容易看花眼。 -->
    <Style x:Key="DownloadNavGroup" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <!-- padding: 10px 10px 6px 10px（Head 的 setContentsMargins(10, 10, 10, 6)） -->
        <Setter Property="Margin" Value="10,10,10,6" />
    </Style>

    <!-- 折叠组的标题栏：一张卡（圆角 8），点哪儿都能展开/收起 -->
    <Style x:Key="CollapsibleHeader" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <!-- QSS 的 padding: 11px 14px（先竖后横，WPF 是 左,上,右,下） -->
        <Setter Property="Padding" Value="14,11,14,11" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 标题栏里的分组名（15px 加粗） -->
    <Style x:Key="CollapsibleHeaderTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- 标题栏右边的副标题（"最新版 0.19.5（共 253 个）"）：12px、常规粗细 -->
    <Style x:Key="CollapsibleHeaderNote" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!--
      大版本胶囊（版本详情页顶部那排「全部 / 26.3 / 1.20 / 1.16 …」，照 PCL2 的样式）。

      · 普通项：浅灰文字 + 透明底，鼠标悬停给一层浅底（`CardHoverBrush`）
      · 选中项：**实心强调色 + 白字**（`AccentFillBrush` / `OnAccentBrush`）
      · 圆角 = 高度一半（14 / 28）→ 永远是"胶囊"，不是圆角矩形

      ⚠️ 选中态用的是**主题的强调色**，不是写死的深蓝：PCL 那边是蓝的，
         但本工程的强调色是绿的（搜索按钮 / 侧栏选中态都是它），
         这里跟主题走才不至于在界面里单蹦出一块别家的蓝。
         真要固定深蓝：把这两个 Setter 换成具体色值即可，只动这一处。
      ⚠️ `IsChecked` 触发器放在 `IsMouseOver` **后面**：同属性后者胜，
         这样"悬停一个已选中的胶囊"时底色还是强调色，不会被悬停底盖掉。
    -->
    <Style x:Key="VersionPill" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <!-- padding: 0 13px（高度固定 28，所以只给左右内边距） -->
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Pill"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 状态行右边那个「刷新」：**纯文字**按钮。
         ⚠️ 别跟上面的 LinkButton 搞混：本文件里的 LinkButton 是从 40-about-log.qss 翻过来的
            「透明底 + 细描边」次要按钮；而下载页用的 #LinkButton 出自 app/30-badges 那一份，
            是 `background: transparent; border: none; padding: 2px 6px; color: text_dim`。
            两个 QSS 文件同名不同长相，所以这里给下载页这份单列一个键，键名不覆盖原来的。 -->
    <Style x:Key="TextLinkButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- padding: 2px 6px -->
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- QSS 只有 hover 改文字色，没有底色 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 展开出来的每一行版本：**独立的小卡**，底色比卡片暗一级（用页面色而不是卡片色）——
         行和标题都是卡，层次靠这句话拉开：标题是 bg_card、行是 bg_page。
         ⚠️ 底色故意**不用** CardSurfaceBrush：那样行和它所在的卡片就完全同色了，
            看着会糊成一片（1.0.0 的 #RemoteVersionRow 用的也是 bg_page）。 -->
    <Style x:Key="RemoteVersionRow" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource BgPageBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <!-- QSS 的 padding: 10px 6px（行的 mouse 区域要宽一点，好点） -->
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 安装选项页顶上那个"选中的游戏版本"小块（22px 图标 + 版本号） -->
    <Style x:Key="VersionChip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <!-- QSS 的 padding: 5px 10px 5px 14px（左窄右宽，右边留出呼吸） -->
        <Setter Property="Padding" Value="10,5,14,5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="VersionChipName" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- 分类栏里的一行（= QSS 的 `QListWidget::item` / `#VersionList::item`）。
         ⚠️ **必须自带模板**：分类栏的项内容是个裸字符串（没有自带内边距的行控件），
            沿用 VersionListItem / VersionRowTemplate 量出来只有 25px 高 ——
            就是用户说的"行太扁、挤在一起"。这里把 QSS 的
            `QListWidget::item { padding: 9px 10px; border-radius: 8px; margin-bottom: 2px; }`
            落到模板上：**内边距写在模板里的 ContentPresenter 上，行距写在 Border 的
            Margin 上**（只加 ListBoxItem.Padding 是没用的 —— WPF 的 ListBoxItem
            不会把 Padding 传给模板，这是最容易漏的一处）。
         ⚠️ 行高用 MinHeight 钉住而不是纯靠 padding：1.0.0 一行 = 36px
            （14px 字 + 上下内边距 + 2px 行距），而 WPF 的行盒本身就比 Qt 高
            5px 左右（字体度量不同），照抄 9px 会变成 43px、反而比 1.0.0 松。
            所以按"**整行 36px**"这个结果来钉：34（行盒子）+ 2（下边距）= 36。
            字号一变（DPI / 换字体）时 MinHeight 只是下限，行会自己撑开，不会截字。

         ⚠️⚠️ **36 这个数必须钉在 ListBoxItem 上（见下面的 DownloadNavItem），
            钉在模板这层 Border 上会少 0.8px**。实测（`download:kbd` 那条诊断入口
            打出来的真值）：Border 写 MinHeight=34 时，行高量出来是 **35.2** 而不是 36 ——
            因为主窗口开了 `UseLayoutRounding`，而本机是 **125%** 缩放：
            34 DIP × 1.25 = 42.5 设备像素 → 被舍成 42 → 又除回 1.25 = 33.6 DIP，
            加上那 2 DIP 下边距正好 35.2。把 36 放到 ListBoxItem 上就整除
            （36 × 1.25 = 45，不用舍），任何缩放下都是整 36。
            内层 Border 仍然留着 MinHeight=34：它是"文字不许被截"的下限。 -->
    <ControlTemplate x:Key="DownloadNavRowTemplate" TargetType="{x:Type ListBoxItem}">
        <Border x:Name="Bd"
                Margin="0,0,0,2"
                MinHeight="34"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="10"
                SnapsToDevicePixels="True">
            <!-- 左右各 9 + 那 1px 边框 = QSS 的 padding 左右各 10px。
                 ⚠️ 边框也算进"内容从哪儿开始"，写 10 的话文字会比分组标题
                    （它没有边框、就是 10）多缩进 1px，两列对不齐 —— 实测过。
                 上下 6 是为了凑满上面说的 34px 行盒子 -->
            <ContentPresenter Margin="9,6" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <!-- 悬停**只换底色，不描边**（= 20-inputs.qss 的 `QListWidget::item:hover
                 { background-color: bg_elevated }`，那条规则里没有 border）。
                 card_style.py 的 HOVER_SELECTORS 里确实给 `#VersionList::item:hover`
                 加过 accent 描边，但那段是**卡片透明度 < 100% 时才追加的覆盖块**
                 （opacity_stylesheet 在 100% 时直接 return ""），默认配置下 1.0.0
                 的悬停并没有框。之前的版本把它当常态画了出来 —— 结果鼠标停在哪一行，
                 哪一行就套一圈圆角描边，看着像"第二个选中项"（用户就是这么报的）。 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBgBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 分类栏里的一个可选分类项：悬停浮起、选中铺淡绿（**只有这两种视觉**）。
         ⚠️ 它**不是** ListBoxItem：分类栏是个 ListBox，但分组标题不可选，
            所以整栏用 ListBox + 这个样式表达，见 DownloadPage.xaml 的注释。
         ⚠️ FocusVisualStyle 再显式写一遍（ListItem 里已经有了）：分类栏是"点一下就
            切内容"的地方，WPF 默认那圈虚线焦点框会跟选中态混在一起，看着像选了两项。
            去掉的只是**那圈框**：ListBox / ListBoxItem 的 IsTabStop、方向键导航一个没动，
            Tab 照样进得来、上下键照样切分类（`page=download:kbd` 那条自动化入口就是
            用来截"键盘焦点落在某一项上"的样子的）。
         ⚠️ MinHeight=36（**整行**，含模板里那 2px 下边距）就是 QSS 的一行 36px，
            为什么钉在这一层、不钉在模板的 Border 上：见 DownloadNavRowTemplate 的注释。 -->
    <Style x:Key="DownloadNavItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource VersionListItem}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Template" Value="{StaticResource DownloadNavRowTemplate}" />
    </Style>

    <!-- 分组标题那一项：不可选、不吃悬停，只当一块文字占位 -->
    <Style x:Key="DownloadNavHeadItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================================
         十四、动效设置对话框
         照 1.0.0 的 `parts/60-dialogs.qss` 里「动效设置对话框」那一段翻
         （ui/dialogs/anim_settings_dialog.py）。标题 / 说明 / 选中项说明复用
         DialogTitle / HintText / FieldLabel / AnimDetail，这里只补它独有的两块：
         预设列表、速度档。

         键名**跟 QSS 的 ID 同名**（AnimPresetList / SpeedOption）。
         ========================================================================================== -->

    <!-- 左边那列动效预设。
         QSS：`#AnimPresetList { background-color: @bg_card@; border: 1px solid @border@;
         border-radius: 10px; padding: 4px; font-size: 13px; }`
         ⚠️ 底色走 BgCardBrush 而**不是** CardSurfaceBrush：QSS 原文就是 @bg_card@，
            而 card_style.py 的 CARD_SELECTORS 里没有 #AnimPresetList —— 它不跟
            「卡片透明度」那一档走（跟本文件开头那 4 个宿主算的刷子无关）。
         ⚠️ 必须自带 Template：BaseListBox 的模板画的是**方角**边框，
            这里要圆角 10（照 QSS）。列表项容器沿用 ListItem（= QListWidget::item
            的 hover/选中都是 bg_elevated + 强调色文字），跟 1.0.0 一致。 -->
    <Style x:Key="AnimPresetList" TargetType="{x:Type ListBox}" BasedOn="{StaticResource BaseListBox}">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False"
                                      Padding="0"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter SnapsToDevicePixels="True" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 速度档（五档竖着排）。
         QSS：`#SpeedOption { color: @text_secondary@; font-size: 12px; padding: 2px 6px;
         spacing: 8px; }` + `:checked { color: @accent_text_strong@; background-color:
         @accent_bg@; border-color: @accent_border@; }`
         也就是「全局 QRadioButton（padding 9px 11px / spacing 9px）的紧凑变体」，
         其余观感原样继承。
         ⚠️ 为什么另写一份 Template 而不是 BasedOn 全局那份：指示器与文字之间的
            spacing 是**写死在模板里**的（全局那份是 9px），派生样式改不到它；
            而 #SpeedOption 要的正是 8px 这一处差别。 -->
    <Style x:Key="SpeedOption" TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <!-- padding: 2px 6px（QSS 是先竖后横，WPF 是 左,上,右,下） -->
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="17"
                                    Height="17"
                                    CornerRadius="4"
                                    Background="{DynamicResource BgCheckBrush}"
                                    BorderBrush="{DynamicResource BorderHoverBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="Check"
                                      Data="M 0,3.5 L 3.5,7 L 9,1"
                                      Stroke="{DynamicResource OnAccentBrush}"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <!-- QSS 的 `spacing: 8px` -->
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBgBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <!-- 禁用态后置：Qt 里 disabled 会盖掉 checked 的配色 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderDisabledBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource BgDisabledBrush}" />
                            <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ==========================================================================================
         十五、模组页：详情页（列表 → 详情 的二级页面）
         照 1.0.0 的 `parts/80-mods.qss` 后半段翻（#ModDetailCard / #ModVersionCard /
         #ModGroupHeader / #ModPickHint 那一批）。上一批只翻了搜索结果卡（十一之二），
         这一节把详情页缺的那几块补齐，末尾那份"没翻清单"里对应的条目一并销账。

         ⚠️ 位置有讲究：**必须排在十一（列表）和十三（下载页）之后**。
            详情页的版本行复用 VersionRow 控件（它内部引用 RemoteVersionRow），
            StaticResource 只往回找，排前面会在运行时炸"找不到资源"。

         ⚠️ 底色一律用 CardSurfaceBrush / CardHoverBrush（不是 BgCardBrush）：
            card_style.py 的 CARD_SELECTORS 里有 #ModDetailCard / #ModVersionCard，
            它们要跟着「卡片透明度」一起变 —— 这条在本文件末尾的"已知差异"里点过名。
         ========================================================================================== -->

    <!-- 详情页顶上那张信息卡（图标 + 名字 + 作者 + 简介 + 统计）。
         QSS：`#ModDetailCard { bg_card; border; border-radius: 10px; }`，内边距 16 由页面给。 -->
    <Style x:Key="ModDetailCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 卡片里的文字一律透明底（同 #ModCard QLabel 那条规则），不然会盖住 hover 底色 -->
    <Style x:Key="ModDetailText" TargetType="{x:Type TextBlock}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 项目名：18px 加粗提亮（比搜索卡的 14px 大一档，进详情页要"放大"） -->
    <Style x:Key="ModDetailName" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModDetailText}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 项目 id（slug）：12px 最淡，跟在名字后面 -->
    <Style x:Key="ModDetailSlug" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModDetailText}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 作者 / 类型那一行，和底部统计数字：12px 中灰 -->
    <Style x:Key="ModDetailMeta" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModDetailText}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ModDetailStats" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModDetailMeta}" />

    <!-- 简介：12px、比 meta 亮一档（它是正文，不是脚注）、自动换行 -->
    <Style x:Key="ModDetailDesc" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModDetailText}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 详情页的大图标坑位：96×96、圆角 10（QSS 的 #ModDetailIcon）。
         ⚠️ 跟搜索卡一样是"底块 + 图"两层，图没下来时露出来的是兜底方块图，
            不会是一个空洞。Clip 由代码按圆角给（Border 不裁子元素）。 -->
    <Style x:Key="ModDetailIconWell" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 详情页里的一行版本：名字 + 元信息 + 右边的绿色「下载」。
         QSS：`#ModVersionCard { bg_card; border; border-radius: 8px; }`，
         内边距 12px 9px（先竖后横 → WPF 的 12,9,12,9）由页面给。 -->
    <Style x:Key="ModVersionCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ModVersionName" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ModVersionMeta" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 版本类型徽章（正式版 / 测试版 / 快照）。
         ⚠️ QSS 用属性选择器 `#ModVersionBadge[vtype="release"]` 选色；WPF 的等价物是
            "给 Tag 设值 + DataTrigger"，做法参考本文件 AccountChipChevron。
            所以这里一个样式 + 三个 Tag 触发的配色，页面只负责设 Tag。 -->
    <Style x:Key="ModVersionBadge" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <!-- QSS 的 padding: 1px 6px -->
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextBlock.FontSize" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="release">
                <Setter Property="Background" Value="{DynamicResource AccentBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentTextBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="beta">
                <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}" />
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource WarnBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="alpha">
                <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 详情页底部那行状态（"…下载会落到：<路径>" / "还没设置游戏目录…"） -->
    <Style x:Key="ModPickHint" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>


    <!-- ==========================================================================================
         十六、版本设置页（parts/70-version-settings.qss）
         #TabButton / #SectionToggle / #CardSep / #NoticeTitle 这四条已经分别在
         第四节（可勾选按钮）和第二节（容器）里翻好了（70-version-settings.qss 就是
         它们唯一的来源），所以这一页**不需要**新的一套控件样式 —— 卡片、字段名、
         说明文字全部复用 #Card / #FieldLabel / #HintText（1.0.0 的 QSS 注释里
         专门写了"免得又多一套长得差不多的样式"）。
         这里只补一条 QSS 里查不到的东西。
         ========================================================================================== -->

    <!--
      输入框的占位文案（Qt 的 `QWidget.setPlaceholderText`）。
      ⚠️ 它**不是 QSS**：1.0.0 是在 Python 里调 setPlaceholderText 的控件属性，
         所以 70-version-settings.qss 里没有它，下面那份「没翻清单」里也不该有它。
      WPF 的 TextBox 没有对应属性，本工程的做法是"同一个格子里垫一个 TextBlock"：
         页面把两者放进同一个 Grid，由页面的 HookPlaceholder() 按 Text 是否为空切换可见性。
      ⚠️ 用垫 TextBlock 而不是 Adorner：离屏截图（App.SaveWindowPng）走的是纯
         Measure/Arrange，Adorner 层不保证被建出来；垫的 TextBlock 一定画得上。
      ⚠️ 左边距 11 = TextBox 的 1px 边框 + 10px padding（20-inputs.qss 的 7px 10px），
         这样占位文案和用户敲进去的字**左边缘对齐**，不会一输入就跳一下。
    -->
    <Style x:Key="FieldPlaceholder" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <!-- 左 11 = 1px 边框 + 10px padding，右 11 让长文案能省略号收尾 -->
        <Setter Property="Margin" Value="11,0,11,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- 垫的这层不能吃掉鼠标事件，否则点输入框要先点穿它 -->
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>


