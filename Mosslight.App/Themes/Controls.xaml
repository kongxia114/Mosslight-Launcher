        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- QSS 用属性选择器 `[kind="ok"]` 选色。WPF 的等价物是页面给 TextBlock 设 Tag 再用
         DataTrigger 切；这里直接把三种状态做成三个键，页面按状态换 Style 就行。 -->
    <Style x:Key="DownloadRowState" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="DownloadRowStateOk" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DownloadRowState}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style x:Key="DownloadRowStateErr" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DownloadRowState}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>


    <!-- ==========================================================================================
         二、容器（Border）
         WPF 的 Border 没有"继承给子元素"的文字属性，但 TextBlock.Foreground / TextBlock.FontSize /
         TextBlock.FontWeight 是可以挂在任意元素上的**继承性附加属性**，所以 QSS 里 container 上的
         `color` / `font-size` / `font-weight` 用这几个附加属性照搬，子标签不用自己再写一遍。
         ⚠️ TextWrapping / HorizontalAlignment 这些**不是**继承属性，挂上去没用，别加。
         ========================================================================================== -->

    <!-- 卡片：页面里最常用的容器。圆角取 QSS 的 12（app.qss 的 `#Card { border-radius: 12px }`）。
         底色/描边走宿主算的 CardSurfaceBrush / CardBorderBrush（带卡片透明度），
         **不是** BgCardBrush —— BgCardBrush 还被侧边栏悬停、档案卡片、按钮禁用态共用着，
         一起变透明界面就花了。 -->
    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 宿主约定的别名 -->
    <Style x:Key="CardBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}" />

    <!-- 侧边栏：只画右边那一条分隔线。
         底色走宿主算的 SidebarBrush（设了背景图时是 bg_sidebar 的 82%，跟"卡片透明度"那一档无关）。 -->
    <Style x:Key="Sidebar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 侧边栏底部的「当前档案」卡片：悬停变浮起色。
         它也在 card_style.py 的 CARD_SELECTORS / HOVER_SELECTORS 里，所以底色、描边、悬停底
         三样都走宿主算的带 alpha 版本。
         ⚠️ 悬停**描边用强调色**（不是 BorderControlBrush）：这是 card_style.py 里
            HOVER_SELECTORS 那段 `border-color: accent` 的原样行为 —— 看着像"顺手写的
            副作用"，但既然是 1.0.0 的实际观感，照搬就不改。 -->
    <Style x:Key="AccountChip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 头像兜底底块（没有皮肤时显示的那个方块）。
         ⚠️ app.qss 给的是圆角 16，40-about-log.qss 后来改成 9 并加了边框 —— 后者赢。 -->
    <Style x:Key="AccountAvatar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
        <Setter Property="TextBlock.FontSize" Value="15" />
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
    </Style>

    <!-- 账户列表行左边的头像，尺寸不同但观感一致 -->
    <Style x:Key="AccountRowAvatar" TargetType="{x:Type Border}" BasedOn="{StaticResource AccountAvatar}" />

    <!-- 主题色那种圆点。QSS 里没有这条（个性化页的调色控件是裸控件），颜色由页面自己
         塞 Background；这里只管形状和描边。CornerRadius 给一个超大值让 WPF 自己夹到
         半宽半高，这样页面改成任意尺寸都还是正圆。 -->
    <Style x:Key="ColorSwatch" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="9999" />
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 提示条 -->
    <Style x:Key="WarningBanner" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <!-- padding: 9px 12px -->
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource WarnBrush}" />
        <Setter Property="TextBlock.FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="ErrorBanner" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="TextBlock.FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 徽章一族 -->
    <Style x:Key="Badge" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource BgControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <!-- padding: 3px 9px -->
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="TextBlock.FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="BadgeAccent" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AccentBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="TextBlock.FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="BadgeWarn" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource WarnBrush}" />
        <Setter Property="TextBlock.FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 版本类型徽章（原版 / 加载器 / 整合包）：圆角更大、字号更大、加粗。
         QSS 里这三条没写 padding，尺寸由代码给；这里补一个和 Badge 同款的 9,3，
         不然文字会贴着边框。 -->
    <Style x:Key="BadgeVanilla" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AccentBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="TextBlock.FontSize" Value="13" />
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="BadgeLoader" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource WarnBrush}" />
        <Setter Property="TextBlock.FontSize" Value="13" />
        <Setter Property="TextBlock.FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
