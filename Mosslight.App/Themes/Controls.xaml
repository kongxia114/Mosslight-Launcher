    </Style>

    <Style x:Key="DownloadSubtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Microsoft YaHei" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DownloadFooter" TargetType="{x:Type TextBlock}">
