<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    ============================================================================
     外壳（侧边栏 + 窗口框架）自己的样式

     ⚠️ 为什么单独一个文件、不复用 Controls.xaml：
        Controls.xaml 是"控件库"（按钮/输入框/下拉框…），这份是"外壳"——
        导航项、档案卡片、品牌字。两者的归属不同，混在一起以后改控件库时
        容易误伤外壳。合并顺序上这份排在 Controls.xaml **后面**，
        所以这里的键名刻意跟那边不重名，避免互相覆盖。

     数值全部来自 1.0.0 的 `assets/styles/app.qss` + `ui/widgets/sidebar.py`，
     不是"看着差不多"调的。
    ============================================================================
  -->

  <!-- 品牌名（标题栏左上角）：产品名不翻译，字号跟标题栏一起放大过一档 -->
  <Style x:Key="ShellBrandText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 「当前档案」这种小节标题：11px 加粗、更暗一档 -->
  <Style x:Key="ShellSectionLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="4,0,4,0" />
  </Style>

  <Style x:Key="ShellVersionText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!--
    导航项。用 ToggleButton 而不是 Button：它天生有"选中"这个状态，
    而 QSS 那边的 `#NavButton:checked` 就是这个语义。
    ⚠️ 三个状态的颜色是 QSS 里逐条对出来的，别自己调：
         常态   文字 text_dim、底透明
         悬停   底 bg_card、文字 text
         选中   底 bg_elevated、文字 accent、加粗
  -->
  <Style x:Key="ShellNavItem" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd"
                  Background="Transparent"
                  CornerRadius="8"
                  Padding="12,10,12,10">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
              <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    底部「当前档案」卡片：整块可点。
    底色用 BgCardBrush（**不是** CardSurfaceBrush）—— 它是外壳的一部分，
    不跟"卡片透明度"那一档走，跟 1.0.0 的 card_style.py 里
    `#AccountChip` 的分类一致（那边虽然也在 CARD_SELECTORS 里，但侧栏这张
    跟外壳一起看更协调，这里按外壳处理）。
  -->
  <Style x:Key="ShellAccountChip" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{DynamicResource BgCardBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="10,9,10,9">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderControlBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ShellAccountName" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="ShellAccountType" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style x:Key="ShellAccountChevron" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- 头像：圆形，用强调色系里那个 avatar_bg -->
  <Style x:Key="ShellAvatarCircle" TargetType="Border">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource AvatarBgBrush}" />
  </Style>

  <Style x:Key="ShellAvatarText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    页面标题 / 副标题 / 小节标题 / 提示文字。
    ⚠️ 这几个跟 Controls.xaml 里的同名键是**故意重复**的：那几个是给"对话框和
       卡片内部"用的，这几个给"页面顶栏"用。数值一样（24px 加粗 / 13px faint），
       以后哪边要改也不会互相牵连。
  -->
  <Style x:Key="ShellPageTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="ShellPageSubtitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ==========================================================================
       自绘标题栏上的按钮（最小化 / 关闭）

       尺寸 46×40 跟 Windows 自己那套一样：46 是"三颗按钮并排时每颗的宽度"，
       Windows 的用户肌肉记忆就是这个位置和大小，不要为了好看改窄。

       ⚠️ 形状用 `Path` 画、不用 Segoe MDL2 的字形：字形要靠字体存在，
          Win10 1809 上有这个字体、但一旦被用户换掉/精简系统就没有；
          Path 是纯几何，画出来还更锐利（1px 描边不糊）。

       ⚠️ 这两个按钮在 XAML 里必须再套一层
          `WindowChrome.IsHitTestVisibleInChrome="True"`：标题栏整条是
          **原生 caption 区**（拖动/双击最大化/贴边吸附都靠它），
          不标这一句，鼠标事件会被系统当成"拖窗口"吃掉，按钮永远点不动。
       ========================================================================== -->
  <Style x:Key="ShellTitleBarButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <!-- ⚠️ 不写死 Height：标题栏改高（比如 40 → 52）按钮要自己跟着长满，
         写死的话每改一次高度都得回来同步一遍。Stretch + 横向 StackPanel
         会让它填满整条标题栏，跟 Windows 自己那三颗按钮一样。 -->
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- 不抢焦点：点最小化/关闭之后，窗口内的输入焦点不该跳走 -->
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 关闭按钮：悬停底色取 Windows 那个红（#C42B1C），文字转白。
       ⚠️ 这不是"随便挑的红"：它跟系统自带的关闭键同一色，
          用户点的时候不会觉得"这个红怪怪的"。 -->
  <Style x:Key="ShellTitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource ShellTitleBarButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#9B2114" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
