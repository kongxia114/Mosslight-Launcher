<Window x:Class="Mosslight.App.Views.BackgroundSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
        Title="{loc:Tr 背景设置}"
        Width="680" Height="560"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Background="{DynamicResource BgPageBrush}">

  <!--
    「背景设置」对话框。照搬 1.0.0 的 ui/dialogs/appearance_dialog.py 里**背景那一段**
    （背景图 / 铺法 / 纯色 / 压暗 / 卡片透明度），改完立刻生效、不用重启。

    ⚠️ 1.0.0 那份还捎带了「游戏目录」和「多线程下载 / 线程数」—— 那两个在 2.0 里
       已经搬到「设置」页了，这里**不重复一份**：同一件事两个入口，迟早有一边过期。

    ⚠️ 数值照抄，不"顺手改"：
       · 压暗 0~200 —— 1.0.0 里这个值**直接当 alpha 用**，不是百分比
         （BackgroundHost 里对应 `Color.FromArgb((byte)dim, 0, 0, 0)`）
       · 卡片透明度 10~100 —— 下限 10 是 BackgroundModes.MinCardOpacity：
         全透明卡片等于界面坏了
       · 铺法顺序取 BackgroundModes.Order（对齐 Windows 的"选择适合度"）

    ⚠️ 这里**几乎不发新文案键**：1.0.0 那批文案在语言文件里已经全都有
       （`背景图` / `铺法` / `压暗` / `卡片透明度` / `浏览…` / `恢复默认` / 各档说明…）。
       **唯一新增**的是那条单行「纯色只在没有背景图时生效…」—— 因为 1.0.0 那句
       是**一个含换行**的键，而 XAML 属性值里的换行会被 XML 规范成空格，键就对不上。

    布局照 Python 的 `root.setContentsMargins(18,18,18,18)` + `setSpacing(12)`：
    WPF 没有 spacing，用每行的下边距等价表达。
  -->
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <!-- 标题 -->
      <RowDefinition Height="Auto" />
      <!-- 顶部说明 -->
      <RowDefinition Height="Auto" />
      <!-- 表单 -->
      <RowDefinition Height="*" />
      <!-- 弹簧 -->
      <RowDefinition Height="Auto" />
      <!-- 底部按钮 -->
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource DialogTitle}" Text="{loc:Tr 自定义背景}" />

    <TextBlock Grid.Row="1" Style="{StaticResource HintText}" TextWrapping="Wrap"
               Margin="0,8,0,0"
               Text="{loc:Tr 图片随便放哪都行（建议 1920×1080 以上）。改完立刻生效。}" />

    <!-- ============================ 表单 ============================ -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <!-- 字段名 -->
        <ColumnDefinition Width="*" />
        <!-- 输入 -->
        <ColumnDefinition Width="Auto" />
        <!-- 按钮 / 数值 -->
        <ColumnDefinition Width="Auto" />
        <!-- 色块 -->
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <!-- 0 背景图 -->
        <RowDefinition Height="Auto" />
        <!-- 1 铺法 -->
        <RowDefinition Height="Auto" />
        <!-- 2 铺法说明 -->
        <RowDefinition Height="Auto" />
        <!-- 3 纯色 -->
        <RowDefinition Height="Auto" />
        <!-- 4 纯色说明 -->
        <RowDefinition Height="Auto" />
        <!-- 5 背景蒙层 -->
        <RowDefinition Height="Auto" />
        <!-- 6 蒙层说明 -->
        <RowDefinition Height="Auto" />
        <!-- 7 卡片透明度 -->
        <RowDefinition Height="Auto" />
        <!-- 8 透明度说明 -->
      </Grid.RowDefinitions>

      <!-- 0 背景图 -->
      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                 VerticalAlignment="Center" Margin="0,0,12,10" Text="{loc:Tr 背景图}" />
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="PathBox" Margin="0,0,10,10"
               VerticalContentAlignment="Center" LostFocus="OnPathCommitted" />
      <Button Grid.Row="0" Grid.Column="2" x:Name="BrowseButton" Margin="0,0,0,10"
              Content="{loc:Tr 浏览…}" Click="OnBrowse" />

      <!-- 1 铺法 -->
      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                 VerticalAlignment="Center" Margin="0,0,12,4" Text="{loc:Tr 铺法}" />
      <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ModeCombo"
                Margin="0,0,0,4" SelectionChanged="OnModeChanged" />

      <!-- 2 当前铺法的说明（跟着选项变） -->
      <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ModeHint"
                 Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10" />

      <!-- 3 纯色背景 -->
      <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                 VerticalAlignment="Center" Margin="0,0,12,6" Text="{loc:Tr 纯色背景}" />
      <TextBox Grid.Row="3" Grid.Column="1" x:Name="ColorBox" Margin="0,0,10,6"
               VerticalContentAlignment="Center" LostFocus="OnColorCommitted" />
      <Button Grid.Row="3" Grid.Column="2" x:Name="PickColorButton" Margin="0,0,10,6"
              Content="{loc:Tr 选颜色…}" Click="OnPickColor" />

      <!-- 取色弹层（挂在「选颜色…」下面）。
           ⚠️ 为什么不是系统取色器：WPF 没有内置的，`System.Windows.Forms.ColorDialog`
              要在 csproj 开 `<UseWindowsForms>`，而那会把 `System.Windows.Forms`
              灌进整个项目的隐式 using —— `Application` / `UserControl` / `Panel` /
              `Brush` / `IDataObject` 在几十个文件里当场变成二义（实测 build 直接红 10 条）。
              所以这里用三个 RGB 滑块自带一个，零依赖、还能像主界面那样拖着实时变。 -->
      <Popup Grid.Row="3" Grid.Column="2" x:Name="ColorPopup"
             PlacementTarget="{Binding ElementName=PickColorButton}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True" Margin="0,4,0,0">
        <Border Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12,10,12,12">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Style="{StaticResource FieldLabel}" Width="12" VerticalAlignment="Center" Text="R" />
              <Slider x:Name="PickRSlider" Width="150" Minimum="0" Maximum="255"
                      Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="OnPickedColorChanged" />
              <TextBlock x:Name="PickRValue" Style="{StaticResource ValueLabel}" Width="30"
                         VerticalAlignment="Center" Margin="8,0,0,0" Text="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Style="{StaticResource FieldLabel}" Width="12" VerticalAlignment="Center" Text="G" />
              <Slider x:Name="PickGSlider" Width="150" Minimum="0" Maximum="255"
                      Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="OnPickedColorChanged" />
              <TextBlock x:Name="PickGValue" Style="{StaticResource ValueLabel}" Width="30"
                         VerticalAlignment="Center" Margin="8,0,0,0" Text="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Style="{StaticResource FieldLabel}" Width="12" VerticalAlignment="Center" Text="B" />
              <Slider x:Name="PickBSlider" Width="150" Minimum="0" Maximum="255"
                      Margin="8,0,0,0" VerticalAlignment="Center" ValueChanged="OnPickedColorChanged" />
              <TextBlock x:Name="PickBValue" Style="{StaticResource ValueLabel}" Width="30"
                         VerticalAlignment="Center" Margin="8,0,0,0" Text="0" />
            </StackPanel>
            <Border x:Name="PickPreview" Height="22" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" />
          </StackPanel>
        </Border>
      </Popup>

      <!-- 色块只显示当前纯色，不可点 -->
      <Border Grid.Row="3" Grid.Column="3" x:Name="ColorSwatch"
              Width="26" Height="26" CornerRadius="9999" BorderThickness="1"
              BorderBrush="{DynamicResource BorderHoverBrush}"
              SnapsToDevicePixels="True" VerticalAlignment="Center" Margin="0,0,0,6" />

      <!-- 4 纯色说明 -->
      <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                 Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10"
                 Text="{loc:Tr 纯色只在没有背景图时生效（想用纯色要先把背景图那一栏清空）。}" />

      <!-- 5 背景蒙层（0~200，直接当 alpha 用）
           ⚠️ 原来叫「压暗」，但蒙层颜色现在**跟主题走**（见 BackgroundHost.Apply）：
              深色主题是压暗、浅色主题是提亮。继续叫"压暗"就名不副实了。 -->
      <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}"
                 VerticalAlignment="Center" Margin="0,0,12,4" Text="{loc:Tr 背景蒙层}" />
      <Slider Grid.Row="5" Grid.Column="1" x:Name="DimSlider" Minimum="0" Maximum="200"
              Margin="0,0,10,4" VerticalAlignment="Center" ValueChanged="OnDimChanged" />
      <TextBlock Grid.Row="5" Grid.Column="2" x:Name="DimValue" Style="{StaticResource ValueLabel}"
                 Width="34" VerticalAlignment="Center" Margin="0,0,0,4" Text="0" />

      <!-- 6 蒙层说明 -->
      <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource HintText}"
                 TextWrapping="Wrap" Margin="0,0,0,10"
                 Text="{loc:Tr 深色主题下这层蒙层压暗、浅色主题下提亮 —— 图太花就往上调。}" />

      <!-- 7 卡片透明度（10~100） -->
      <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}"
                 VerticalAlignment="Center" Margin="0,0,12,4" Text="{loc:Tr 卡片透明度}" />
      <Slider Grid.Row="7" Grid.Column="1" x:Name="OpacitySlider" Minimum="10" Maximum="100"
              Margin="0,0,10,4" VerticalAlignment="Center" ValueChanged="OnOpacityChanged" />
      <TextBlock Grid.Row="7" Grid.Column="2" x:Name="OpacityValue" Style="{StaticResource ValueLabel}"
                 Width="40" VerticalAlignment="Center" Margin="0,0,0,4" Text="100%" />

      <!-- 7 透明度说明
           ⚠️ 这一条的文案里含 `100% = 完全不透明`。**不能**用 loc:Tr 标记扩展写在
              XAML 里：标记扩展里 `=` 是"属性=值"的分隔符，解析器会把
              `…（100%` 当成属性名直接报 MC3045。所以文字在 code-behind 里设。
           ⚠️ 注释里也**不要**写出花括号形态的那个标记扩展：`check_lang_keys.py`
              是全文扫描的，注释里的也会被当成"用到的键"去语言文件里找 → 报缺键。 -->
      <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" x:Name="OpacityHint"
                 Style="{StaticResource HintText}"
                 TextWrapping="Wrap" Margin="0,0,0,4" />
    </Grid>

    <!-- ============================ 底部 ============================ -->
    <Grid Grid.Row="4" Margin="0,16,0,0" VerticalAlignment="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="{loc:Tr 恢复默认}" Click="OnReset" />
      <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
              Content="{loc:Tr 关闭}" Click="OnClose" IsDefault="True" />
    </Grid>
  </Grid>
</Window>
