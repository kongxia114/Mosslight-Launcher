<Window x:Class="Mosslight.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
        Title="{loc:Tr 确认}"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPageBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}">

    <Border BorderThickness="1" BorderBrush="{DynamicResource DangerBrush}">
        <StackPanel Margin="24,20,24,18">
            <TextBlock x:Name="HeadlineText" TextWrapping="Wrap"
                       Style="{StaticResource SectionTitle}"
                       Foreground="{DynamicResource DangerBrush}" />

            <Border Height="1" Margin="0,12,0,0" Opacity="0.55"
                    Background="{DynamicResource DangerBrush}" />

            <TextBlock x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap"
                       Style="{StaticResource HintText}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{loc:Tr 取消}" IsCancel="True" MinWidth="88"
                        Style="{StaticResource GhostButton}" Click="OnCancelClick" />
                <Button x:Name="ConfirmButton" Content="{loc:Tr 确定}" IsDefault="True" MinWidth="88"
                        Margin="8,0,0,0"
                        Style="{StaticResource DangerButton}" Click="OnConfirmClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
