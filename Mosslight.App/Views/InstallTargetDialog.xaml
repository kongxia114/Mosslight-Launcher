<Window x:Class="Mosslight.App.Views.InstallTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
        Title="{loc:Tr 装到哪儿？}"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPageBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}">

    <!--
        ⚠️ 这里**只负责选目录**，不下载：下载走原来的 `IModService.InstallAsync`，

        设计说明见 docs/design-notes.md#mosslight-app-views-installtargetdialog-xaml
      -->
    <StackPanel Margin="22,18,22,16">
        <TextBlock Text="{loc:Tr 装到哪儿？}" Style="{StaticResource SectionTitle}" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="{loc:Tr 选一个版本，或者自己挑一个文件夹。下载会落到它下面的子目录里。}"
                   Style="{StaticResource HintText}" />

        <TextBlock Margin="0,14,0,6" Text="{loc:Tr 装到哪个版本}" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="TargetBox" SelectionChanged="OnTargetChanged" />

        <TextBlock Margin="0,12,0,6" Text="{loc:Tr 会下载到}" Style="{StaticResource FieldLabel}" />
        <Border Background="{DynamicResource BgControlBrush}"
                BorderBrush="{DynamicResource BorderControlBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8">
            <TextBlock x:Name="PathText" TextWrapping="Wrap"
                       Style="{StaticResource HintText}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Tr 取消}" IsCancel="True" MinWidth="88"
                    Style="{StaticResource GhostButton}" Click="OnCancelClick" />
            <Button x:Name="ConfirmButton" Content="{loc:Tr 下载}" IsDefault="True" MinWidth="88"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
