<UserControl x:Class="Mosslight.App.Views.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
             FontFamily="{StaticResource UiFont}">
  <!--
    ============================================================================
      「启动游戏」页

    逐块照搬 1.0.0 的 `ui/pages/home_page.py`：版式、文案、间距都对着那份源码抄，
    没有"顺手重新设计"。

    整页布局（那边是 QVBoxLayout，setContentsMargins(32, 28, 12, 12)、setSpacing(6)）：
        标题「启动游戏」（QSS #PageTitle → ShellPageTitle）
        副标题「选择版本和档案，然后启动」（QSS #PageSubtitle → ShellPageSubtitle）
        [扫描告警条 —— 有版本读不了时才显示]
        ……吃掉剩余高度的弹性空白……
        右下角的启动面板（固定 460 宽，贴住右下角）

    ⚠️ 右边和下边只留 12：面板要「紧贴右下角」（1.0.0 的用户 2026-09 专门要求过），
       边距留大了它会飘在画面中间。1.0.0 的注释写的是"太窄按钮排不下，
       太宽在 1280 的窗口里显得空"。

    ⚠️ 行距的算法照抄 Qt 的 addSpacing：Qt 只在**相邻两项之间**插一次 spacing，
       而 addSpacing(n) 加进去的那个 n 会顶掉一侧 —— 所以「spacing 6 + addSpacing 12」
       的间距是 18，不是 6+12+6=24。
       告警条那一行折叠着的时候不占位（WPF 的 Collapsed 跟 Qt 的 hide() 一样
       会把间距一起收掉），所以副标题到面板平时是 18；
       告警条展开时它自己是 18、面板改成 6（这个切换在 ShowScanErrors() 里做）。

    ⚠️ 颜色一律走主题键，不写 #rrggbb：写死了浅色主题就会漏掉那一条。
  ============================================================================
  -->
  <Grid x:Name="Root" Margin="32,28,12,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" Grid.Row="0"
               Style="{StaticResource ShellPageTitle}"
               Text="{loc:Tr 启动游戏}" />

    <!-- 副标题跟标题之间是 layout.setSpacing(6) -->
    <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,6,0,0"
               Style="{StaticResource ShellPageSubtitle}"
               Text="{loc:Tr 选择版本和档案，然后启动}" />

    <!--
      扫描告警条（#WarningBanner：warn_bg 底 + warn 字 + 圆角 8 + 9/12 内边距）。
      1.0.0 在这儿显示"⚠ N 个版本读不了：…"。
      ⚠️ 2.0 的服务契约（IGameService.RefreshAsync）还没有"哪些版本读不了"这个返回，
         所以这一条现在**永远不显示** —— 留着是为了版式和接口都在，
         扫描器哪天把错误暴露出来，ShowScanErrors() 一调就长出来了。
    -->
    <Border x:Name="ScanWarningBanner" Grid.Row="2" Margin="0,18,0,0"
            Style="{StaticResource WarningBanner}"
            Visibility="Collapsed">
      <TextBlock x:Name="ScanWarningText" TextWrapping="Wrap" />
    </Border>

    <!-- 弹性空白 + 右下角的面板。Margin 见文件头关于 addSpacing 的说明。 -->
    <Grid x:Name="BodyRow" Grid.Row="3" Margin="0,18,0,0">
      <!--
        启动面板：_make_launch_panel() 里的 card
          setObjectName("Card")            → CardBorder（底/描边走"卡片透明度"，圆角 12）
          setFixedWidth(PANEL_WIDTH = 460)
          box.setContentsMargins(22, 20, 22, 18)
          box.setSpacing(10)
        下面每个孩子的 Margin 就是"上一项到这一项"的那 10（个别地方还有 addSpacing(4)）。
      -->
      <Border x:Name="LaunchCard"
              Style="{StaticResource CardBorder}"
              Width="460"
              Padding="22,20,22,18"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom">
        <StackPanel>

          <!--
            启动按钮：**两行文字**（大字「启动游戏」+ 小字版本号）。
            1.0.0 那边是个 QFrame + 两个 QLabel —— 因为 QPushButton 不排版富文本
            （`<b>…</b><br>…` 的 sizeHint 会按原始字符串算，结果是截断）。
            WPF 的 Button 里放 StackPanel 没这个问题，所以直接用 Button（还能白拿
            hover / pressed / disabled 三态）。
              setFixedHeight(66)         → Height="66"
              contentsMargins(12,8,12,8) → 内层 StackPanel 的 Margin
              spacing 1                  → 副标题的 Margin="0,1,0,0"
            QSS #LaunchButton：圆角 10、无边框、accent_fill 底 / hover / pressed 各一档
            —— 三档颜色都在 Themes\Controls.xaml 的 LaunchButton 里，这里不重写。
          -->
          <!--
              两行文字（主标题 + 副标题）都居中，并且**不许出框**：
              · Height 从 66 加到 72：运行态副标题是"点击强制结束游戏进程"，比版本号那行长；
              · 内容栈整体垂直居中，副标题 Margin 0,4,0,0 拉开层次；
              · 副标题限宽 + 省略号，长文案宁可截断也不横向溢出；
              · ClipToBounds 兜底：万一主题字体把行高撑大，也不会画到按钮外面。
          -->
          <Button x:Name="LaunchButton"
                  Style="{StaticResource LaunchButton}"
                  Height="72"
                  ClipToBounds="True"
                  Click="OnLaunchClick">
            <StackPanel Margin="12,6,12,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <TextBlock x:Name="LaunchTitleText"
                         Style="{StaticResource LaunchTitle}"
                         HorizontalAlignment="Center"
                         TextAlignment="Center" />
              <TextBlock x:Name="LaunchSubtitleText" Margin="0,4,0,0"
                         Style="{StaticResource LaunchSubtitle}"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         MaxWidth="400"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>

          <!--
          ⚠️ 主面板**只留这些**（照 PCL2 的主面板）：
          启动按钮 +（出问题时才出现的警告条）+ 两个按钮 + 状态行。
          同一件事不开第二个门：
          · 版本名已经在按钮副标题里，不再单列一行；
          · Java / 内存 / 加载器 / 隔离收进**启动按钮的 ToolTip**（见 UpdateLaunchText），
            平时不占地方，想知道时鼠标停一下就有；
          · 「当前档案」只留在左侧栏底部那张卡片上。
          ⚠️ 按钮里**不放图标**：这一排要的是纯按钮。
          -->

          <!--
            起不来的原因（#BadgeWarn：warn_bg 底 + warn 描边 + 圆角 6 + 3/9 内边距）。
            1.0.0 的注释：「别等用户点了启动才弹窗告诉他」。
            有才显示 —— 折叠着的时候不占位。
          -->
          <Border x:Name="VersionWarnBadge" Margin="0,10,0,0"
                  Style="{StaticResource BadgeWarn}"
                  Visibility="Collapsed">
            <TextBlock x:Name="VersionWarnText" TextWrapping="Wrap" />
          </Border>

          <!--
            「选择版本」「版本设置」。

            ⚠️ 两个按钮**平分这一行**，不要靠左堆着：面板宽 460，这两个按钮按文字量
               算只有 86px 宽 —— 靠左一放右边空出 257px，跟上面 416px 宽的启动按钮
               完全对不齐（1.0.0 的用户 2026-09 指出"宽度异常、画面上不协调"）。
               等分之后左右边缘跟启动按钮对齐。
            QSS #PanelButton：在裸 QPushButton 上只改 padding(10px 16px) 和字号(13px)。

            下面的 Margin 0,14,0,0 = Qt 的 spacing(10) + addSpacing(4)。
            ⚠️ 不是 10 + 4 + 10 = 24：Qt 的 QBoxLayout 只在**相邻两项之间**插一次
               spacing，显式加进去的那个 4px 间隔项顶掉了一侧 —— 照 24 摆，
               这一行和下面那行会各低 10px，整块面板比 1.0.0 高 20px
               （实测：这样摆面板总高 289，而 1.0.0 的截图量出来是 269）。
          -->
          <Grid x:Name="ButtonRow" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ChooseVersionButton" Grid.Column="0" Margin="0,0,4,0"
                    Style="{StaticResource PanelButton}"
                    Content="{loc:Tr 选择版本}"
                    Click="OnChooseVersionClick" />

            <Button x:Name="VersionSettingsButton" Grid.Column="1" Margin="4,0,0,0"
                    Style="{StaticResource PanelButton}"
                    Content="{loc:Tr 版本设置}"
                    Click="OnVersionSettingsClick" />
          </Grid>

          <!--
            状态行（#StatusText：13px、text_secondary）。
            1.0.0 的注释：只显示**启动器自己**的消息，游戏原始输出不进这一行 ——
            不然会变成一行跳动的英文。文字是动态给的，所以由代码贴（见 code-behind）。
            这里的 Margin 同样是 spacing(10) + addSpacing(4) = 14（理由见上面按钮行）。
          -->
          <TextBlock x:Name="StatusLabel" Margin="0,14,0,0"
                     Style="{StaticResource StatusText}"
                     TextWrapping="Wrap" />

        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
