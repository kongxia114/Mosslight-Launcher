<UserControl x:Class="Mosslight.App.Views.LoadingBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Visibility="Collapsed"
             MaxHeight="0"
             FontFamily="{StaticResource UiFont}">
  <!--
    加载状态条：「正在加载…」+ 来回跑的不确定进度条。移植自 1.0.0 的
    `ui/widgets/loading_bar.py`（`_NO_LIMIT` / `MIN_VISIBLE_MS` / `HIDE_ANIM_MS`
    和那段收起动画都是照它搬的）。

        ┌──────────────────────────────────────────────┐
        │ 正在获取模组加载器…      ▓▓▓▓░░░░░░▓▓▓▓░░░░  │
        └──────────────────────────────────────────────┘

    参数照 `parts/30-badges.qss` 的 #LoadingBar / #LoadingBarText / #LoadingBarTrack：
    外框 = 卡片底 + 描边 + 圆角 10、文字 12px text_secondary、
    槽 6px 高圆角 3 底色 bg_control、chunk 强调色。

    ## 为什么自己画 chunk，不用 WPF 自带的 IsIndeterminate
    Controls.xaml 第十二节的 BaseProgressBar 已经把模板换成"圆角 3 + PART_Indicator"
    了（那是为了**确定进度**：下载进度条要按百分比长），而 WPF 自带的那个来回跑动画
    认的是 `PART_GlowRect` + 自带的 Slide 关键帧 —— 那套模板在这儿没有，
    直接用会得到一个**不动的空条**（正是 1.0.0 注释里警告的"永远不动的空条"）。
    所以这里自带一个 ControlTemplate：槽 + 一个 30% 宽的块，
    由 TranslateTransform 从 0 平移到 (槽宽 - 块宽)。
    动画参数：来回 1.7 秒、三次缓动（起步/收尾各慢一点，中间快），
    **不闪**（1.0.0 的 Qt 不确定模式节奏跟这个接近）。

    ## 为什么用 MaxHeight 做收起动画
    跟 1.0.0 一样：直接 show/hide 是硬切，高度从尺寸提示值动到 0 顺一点。
    ⚠️ 高度是**动到 0 再 Collapsed**，不是只调 Opacity —— 留一条透明但占位的
       空条会把下面的内容顶下去一个洞，比不加还难看。

    ## 外部只碰三个方法
    <see cref="ShowState"/> / <see cref="HideWithDelay"/> / <see cref="IsLoading"/>，
    别去动 Visibility、MaxHeight 和那几条动画 —— 状态机会被绕过去。
  -->
  <Border x:Name="Surface" Style="{StaticResource LoadingBar}"
          Padding="12,8,12,8">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="180" />
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="Label" Grid.Column="0" Margin="0,0,10,0"
                 Style="{StaticResource LoadingBarText}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

      <!-- 槽：6px 高（QSS 的 min/max-height），上下留白靠 VerticalAlignment=Center -->
      <Grid x:Name="TrackHost" Grid.Column="1" Height="6" VerticalAlignment="Center"
            ClipToBounds="True">
        <Border x:Name="Track" Background="{DynamicResource BgControlBrush}"
                CornerRadius="3" SnapsToDevicePixels="True" />
        <Rectangle x:Name="Chunk" Fill="{DynamicResource AccentFillBrush}"
                   RadiusX="3" RadiusY="3"
                   HorizontalAlignment="Left" Visibility="Collapsed">
          <Rectangle.RenderTransform>
            <TranslateTransform x:Name="ChunkShift" X="0" />
          </Rectangle.RenderTransform>
        </Rectangle>
      </Grid>
    </Grid>
  </Border>
</UserControl>
