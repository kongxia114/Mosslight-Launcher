<UserControl x:Class="Mosslight.App.Views.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
             xmlns:views="clr-namespace:Mosslight.App.Views"
             FontFamily="{StaticResource UiFont}">
  <!--
    「社区资源」那几栏共用的页面。移植自 1.0.0 的 `ui/pages/mods_page.py`（那一份 1970 行）。

    ## 一页顶五栏（2026-10 改）
    这一页**接受一个类型参数**（`ModContentType`：模组 / 整合包 / 数据包 / 资源包 / 光影包），
    标题、副标题、搜索框提示、空结果文案、图标兜底、下载落点全跟着类型走。
    左栏「社区资源」的每一栏挂的都是**它自己那一份**实例（同一个 type 只建一次）。
    ⚠️ 差别只有五处，都摆在 `ModContentTypes.cs` 那张表里 —— 页面代码里没有
       "如果是资源包就…"这种分支，加第六栏只动表。

    ## 二级结构：列表页 → 详情页
        列表页：搜索 → 结果卡（图标 + 名称 + 作者 + 两行简介 +
                底部元信息 + 行尾一个「›」）。**占满整页宽度**。
        详情页：点一张卡进去 —— 顶上「← 返回」+ 项目详情卡 + 「<游戏版本>
                匹配你选的版本」折叠组（每行右侧一个绿色「下载」）+ 底部
                "…下载会落到：<路径>"。
    两个面板是同一个 Grid 里叠着的两块（跟下载页那套一样），切的时候只改 Visibility。

    ⚠️ **页顶那排「排序：相关度 / 下载量 / 关注数 / 最新 / 最近更新」2026-10 整排删掉了**
       （用户要求），2026-10 后半段又以搜索卡里「排序」下拉的形式回来了 ——
       现在排序由用户自己挑，规则见 `ModsPage.xaml.cs` 的 `SelectedSort`。

    ## 卡片为什么长这样（照 `parts/80-mods.qss` 的 #ModCard 一族）
        ┌──────────────────────────────────────────────────────────────┐
        │ ┌────┐ Sodium                  作者：jellysquid            ›  │
        │ │ 64 │ 现代渲染优化，显著提升帧率…                            │
        │ └────┘ [模组] [Fabric]  支持 8 个游戏版本    下载 1.5M  关注 12.3K │
        └──────────────────────────────────────────────────────────────┘
      圆角 10、内边距 12、图标 64×64 圆角 8、名称 14 加粗、作者 11 最淡、
      简介 12 中灰（**最多两行**，超出省略）、元信息 11 最淡。
      卡片"能点"靠的是 hover（浮起底 + 强调色描边，见 Controls.xaml 的 ModCard）
      加手型指针，不靠任何常亮的强调色元素。

    ⚠️ 图标那一格是**两层**：后面一个 64×64 的占位底块（#ModCardIconWell），
       前面才是真正的图。图没下来 / 下载失败 / 项目没给 icon_url 时，
       露出来的内置兜底方块图（`Assets\icons\version\` 那批，按类型挑：
       模组→forge、整合包→pack、资源包→GrassPath、光影→RedstoneLampOn、
       数据包→RedstoneBlock），**不会出现空白洞**。理由见 Infrastructure\ModIcons.cs。

    ⚠️ 结果栏是**整页宽**（窗口 - 侧栏），没有"右侧已装模组面板"那一条 ——
       这一页走"列表 → 详情"的二级结构，不管已装的那堆文件。宽度够了，
       所以「支持 N 个游戏版本」直接写在卡片上（见 ModsPage.xaml.cs 的 BuildMetaRow）。

    ## 详情页的版本列表
    一个项目的全部版本按「游戏版本 × 加载器 × 正式/预览」分成若干**折叠组**
    （Fabric API 那种项目几十上百组），排序见 `ModVersionGroups`：
    对得上筛选的排最前，然后游戏版本新的在前、正式版在预览版前面。
    分组是**一批 12 组**地铺，滚到底再续；组内行也是懒建的（一页 60 行）。
    · **数据包那一栏不做**（要先进某一个存档，启动器还没有"选存档"这一步）——
      它在下载页走的是「还没接」那张说明页，根本到不了这一页。
  -->
  <Grid Margin="32,28,32,28">

    <!-- ==================== 一级：搜索结果 ==================== -->
    <Grid x:Name="ResultsPane">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />   <!-- 0 标题 -->
        <RowDefinition Height="Auto" />   <!-- 1 副标题 -->
        <RowDefinition Height="Auto" />   <!-- 2 搜索 -->
        <RowDefinition Height="Auto" />   <!-- 3 加载条 -->
        <RowDefinition Height="Auto" />   <!-- 4 网络告警 -->
        <RowDefinition Height="*" />      <!-- 5 结果（整宽） -->
      </Grid.RowDefinitions>

      <!-- 标题 / 副标题：文字由类型决定（构造函数里按 ModContentType 设） -->
      <TextBlock x:Name="PageTitleText" Grid.Row="0" Style="{StaticResource PageTitle}" />
      <TextBlock x:Name="PageSubtitleText" Grid.Row="1" Margin="0,6,0,0"
                 Style="{StaticResource PageSubtitle}" />

      <!-- 搜索卡：**照 PCL2 的下载页搜索卡排**（2026-10 第二版）
           标题 → 「名称 | 来源」→「版本 | 类型」→ 按钮。
           ⚠️ 标签在控件**左边**（不是上面），两列按 7:3 —— 左列给长输入（名称 / 版本），
              右列给短下拉（来源 / 类型），跟 PCL 一样左宽右窄。
           卡片标题按类型变（「搜索模组」/「搜索资源包」…），文案是 `搜索{kind}`。
           ⚠️ 没有「类型」这一维的栏（数据包 / 光影包）会把那一格收起来，让「版本」跨满整行 ——
              见 ModsPage.xaml.cs 的 HideCategoryCell。 -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14,16,14">
        <StackPanel>
          <TextBlock x:Name="SearchCardTitle" Style="{StaticResource SectionTitle}" />

          <!-- ⚠️ 列宽：标签 Auto、两个控件 7* / 3*。**别给标签定宽** ——
               「名称」「版本」「来源」「类型」字数不一样，定宽会让左右两列的控件起点参差。 -->
          <Grid x:Name="FilterGrid" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="7*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr 名称}"
                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,10" />

            <!-- 名称（= 关键词）。搜索框和提示语叠在同一个格子里：WPF 的 TextBox
                 **没有** placeholder，只能用一层 `IsHitTestVisible="False"` 的 TextBlock
                 叠上去（点得到下面那个输入框，文字也不会被选走）。
                 提示文案按类型变（构造函数里设），显示/隐藏见 ModsPage.xaml.cs 的 UpdateQueryHint。 -->
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,16,10">
              <!-- ⚠️ 这个搜索框**比 BaseTextBox 默认矮一档**（上下内边距 7 → 3）：
                   默认内边距在这条搜索栏上实测是 **51px** 高，比同一排的下拉
                   （MinHeight=36）高出一大截，把卡片撑得虚胖（用户 2026-10：
                   搜索输入框上下高度有点大了，缩一点点）。改成 3 之后是 **35px**，跟下拉齐平。
                   ⚠️ 只改内边距，**不给 Height**：写死高度的话 125% / 150% 缩放下
                      文字会被裁掉一截（BaseTextBox 的高度一直是"内容 + padding"撑出来的）。 -->
              <TextBox x:Name="QueryBox"
                       Style="{StaticResource BaseTextBox}" Padding="10,3"
                       KeyDown="OnQueryKeyDown" />
              <TextBlock x:Name="QueryHint" IsHitTestVisible="False"
                         Margin="11,0,0,0" VerticalAlignment="Center"
                         FontSize="14" Foreground="{DynamicResource TextFaintBrush}"
                         TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 来源：**A 方案只有「全部 / Modrinth」两档**（候选表见 ModFilters.Sources）。
                 ⚠️ 现在两家走的是同一条路（只有 Modrinth），这一格是"以后加第二家"的入口，
                    不是装饰 —— 选项由 ModFilters 那张表来，界面这一层不认产品名。 -->
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Tr 来源}"
                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,10" />
            <ComboBox x:Name="SourceBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,10"
                      SelectionChanged="OnFilterChanged" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr 版本}"
                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <!-- 版本：**可下拉也可手敲**，默认**空着**（2026-10 用户要求：不再默认「全部」，
                 直接敲 1.20.1 就行；框里空着 = 不按版本筛）。
                 ⚠️ 可输入之后不能只看 SelectedItem：手敲一个表里没有的版本号时，
                    SelectedItem 还停在上一项。取值见 ModsPage.xaml.cs 的 GameVersionFilter。
                 ⚠️ WPF 没有 placeholder：跟上面搜索框一样，自己叠一层 TextBlock（VersionHint）。 -->
            <Grid x:Name="GameVersionCell" Grid.Row="1" Grid.Column="1" Margin="0,0,16,0">
              <ComboBox x:Name="GameVersionBox"
                        IsEditable="True" SelectionChanged="OnFilterChanged"
                        KeyDown="OnVersionKeyDown" />
              <TextBlock x:Name="VersionHint" IsHitTestVisible="False"
                         Margin="11,0,28,0" VerticalAlignment="Center"
                         FontSize="14" Foreground="{DynamicResource TextFaintBrush}"
                         TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 类型（= Modrinth 的分类）。没有分类这一维的栏整格收起来（见 HideCategoryCell）。 -->
            <TextBlock x:Name="CategoryLabel" Grid.Row="1" Grid.Column="2" Text="{loc:Tr 类型}"
                       Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="3"
                      SelectionChanged="OnFilterChanged" />

            <!-- 排序已隐藏（控件保留，代码还在读写 SelectedSort） -->
            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
              <ComboBox x:Name="SortBox" SelectionChanged="OnFilterChanged" />
            </StackPanel>
          </Grid>

          <!-- 按钮行：照 PCL 是两个等宽的宽按钮（「搜索」/「重置条件」），不是两个小胶囊 -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="SearchButton" MinWidth="96"
                    Style="{StaticResource PrimaryButton}" Click="OnSearchClick" />
            <Button x:Name="ResetButton" Margin="8,0,0,0" MinWidth="96"
                    Content="{loc:Tr 重置条件}"
                    Style="{StaticResource GhostButton}" Click="OnResetClick" />
          </StackPanel>

          <!-- 状态行：搜索结果数 / 装东西的进度。⚠️ 它归**列表页**，只在列表页上说话 ——
               写它的地方（`SearchAsync` / `ReportProgress`）都不会把"还在干活"这种话
               单独留在这儿不管：搜索那条路在 finally 里兜底清一次，
               安装那条路（详情页发起）必定以一句结论收尾。 -->
          <TextBlock x:Name="StatusText" Margin="0,8,0,0"
                     Style="{StaticResource HintText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 联网等待：**只给这一页的搜索用**（详情页拉版本列表有它自己那条
           DetailLoading，两个面板各一条，谁也不给谁打灯）。
           收起来时整块 Collapsed，不留一条空条在那儿（新写一个 0 高度的洞，比不加还难看）。 -->
      <views:LoadingBar x:Name="SearchLoading" Grid.Row="3" Margin="0,12,0,0" />

      <!-- 网络告警：拉不到的时候**明说**，而且要给出原因 -->
      <Border x:Name="NoticeBanner" Grid.Row="4" Visibility="Collapsed"
              Style="{StaticResource ErrorBanner}" Margin="0,12,0,0" Padding="14,10,14,10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="！" Style="{StaticResource NoticeIcon}" VerticalAlignment="Center" />
          <TextBlock x:Name="NoticeText" Margin="10,0,0,0"
                     Style="{StaticResource NoticeTitle}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 结果：**整页宽**（这一页不走"列表 + 右侧详情栏"那种二级布局） -->
      <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,12,14,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{loc:Tr 搜索结果}" Style="{StaticResource SectionTitle}" />
          <ListBox x:Name="ResultList" Grid.Row="1" Margin="0,8,0,0"
                   Style="{StaticResource BaseListBox}"
                   ItemContainerStyle="{StaticResource ModCardRow}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.ScrollChanged="OnResultsScrollChanged" />
          <!-- 空结果文案由类型决定（构造函数里设，例：「没有找到资源包，…」）
               ⚠️ 一开始就 **Collapsed**：还没搜过的时候把"没有找到"挂在页面上，
                  看着就像搜坏了（1.0.0 是先搜一屏热门再说话，见 ModsPage.OnFirstLoaded）。 -->
          <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="0,16,0,0"
                     Visibility="Collapsed"
                     Style="{StaticResource EmptyState}" VerticalAlignment="Top" />
        </Grid>
      </Border>
    </Grid>

    <!-- ==================== 二级：项目详情 ====================
         跟 1.0.0 的 _make_detail_page 一个排法：
         · 顶部「← 返回」固定不滚
         · 项目详情卡固定不滚
         · **只有版本分组那一块滚**（Fabric API 那种项目几百个版本，
           整页滚的话"返回"会被顶出屏幕）
         · 底部那行"下载会落到 …"固定，随时看得见装到哪 -->
    <Grid x:Name="DetailPane" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />   <!-- 0 返回 -->
        <RowDefinition Height="Auto" />   <!-- 1 项目详情卡 -->
        <RowDefinition Height="Auto" />   <!-- 2 加载条 -->
        <RowDefinition Height="Auto" />   <!-- 3 大版本胶囊（PCL 那排 26.3 / 1.20 / 全部） -->
        <RowDefinition Height="*" />      <!-- 4 匹配你选的版本（只有它滚） -->
        <RowDefinition Height="Auto" />   <!-- 5 下载会落到 … -->
      </Grid.RowDefinitions>

      <!-- QSS 的 #IconButton 是 16px 字（比旁边的正文大一档），高度 34 -->
      <Button x:Name="BackButton" Grid.Row="0" HorizontalAlignment="Left"
              Style="{StaticResource IconButton}"
              FontSize="16" Padding="10,0" Height="34"
              Click="OnBackToResultsClick" />

      <Border Grid.Row="1" Style="{StaticResource ModDetailCard}" Margin="0,10,0,0" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 图标：底块 + 图两层（图没下来也不会是空洞），跟搜索结果卡同一个做法 -->
          <Border x:Name="DetailIconWell" Grid.Column="0" Style="{StaticResource ModDetailIconWell}">
            <Image x:Name="DetailIcon" Width="96" Height="96" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>

          <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <!-- 名字 + slug。⚠️ 用 Grid 而不是横向 StackPanel：
                 横向 StackPanel 不给子元素宽度约束，名字再长也不会出省略号。 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="DetailName" Grid.Column="0"
                         Style="{StaticResource ModDetailName}" />
              <TextBlock x:Name="DetailSlug" Grid.Column="1" Margin="8,0,0,0"
                         Style="{StaticResource ModDetailSlug}" TextTrimming="CharacterEllipsis" />
              <!-- 收藏：一颗星，点一下切一次（`App.Favorites`）。
                   文案在代码里刷（「☆ 收藏」/「★ 已收藏」），所以 Content 不写在这里。 -->
              <Button x:Name="FavoriteButton" Grid.Column="2" Margin="8,0,0,0"
                      Style="{StaticResource IconButton}"
                      FontSize="13" Padding="8,0" Height="26"
                      Click="OnFavoriteClick" />
            </Grid>

            <TextBlock x:Name="DetailMeta" Margin="0,6,0,0"
                       Style="{StaticResource ModDetailMeta}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DetailDesc" Margin="0,6,0,0"
                       Style="{StaticResource ModDetailDesc}" />
            <StackPanel x:Name="DetailBadges" Orientation="Horizontal" Margin="0,8,0,0" />
            <TextBlock x:Name="DetailStats" Margin="0,6,0,0"
                       Style="{StaticResource ModDetailStats}" />
          </StackPanel>
        </Grid>
      </Border>

      <views:LoadingBar x:Name="DetailLoading" Grid.Row="2" Margin="0,12,0,0" />

      <!-- 大版本胶囊（照 PCL2 的版本详情页）：`全部` + `26.3` / `1.20` / `1.16` …
           ⚠️ 只在**能分出两档以上**大版本时出现（单个大版本的项目，摆一排等于摆设）。
           ⚠️ 版本号可能十几个 —— 这行是**横向滚动**，不是换行、也不是挤扁：
              胶囊自由宽度往右排，超出就滚（见 ModsPage.xaml.cs 的 RebuildMajorPills）。
           ⚠️ 外面这层 Border 不是装饰：详情页的背景是**照片**，胶囊直接压上去时
              灰字在亮云上几乎看不见（2026-10 截图里就是这么翻的车）。
           候选由代码按"当前拉到的版本"现算（去掉补丁号：1.20.4 / 1.20.6 → 1.20）。 -->
      <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,8"
              Background="{DynamicResource CardSurfaceBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="10"
              SnapsToDevicePixels="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ScrollViewer x:Name="MajorVersionScroll" Grid.Column="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        PanningMode="HorizontalOnly"
                        Focusable="False">
            <StackPanel x:Name="MajorVersionPills" Orientation="Horizontal" />
          </ScrollViewer>

          <!-- 版本通道开关（默认关）：关掉时下方只留正式版，pre / rc / beta / alpha / 快照
               全被滤掉。⚠️ 它固定在**最右边**，不跟着胶囊横向滚走 ——
               滚动内容在左列，它是右列。 -->
          <CheckBox x:Name="ShowPrereleaseBox" Grid.Column="1" Margin="16,0,0,0"
                    Style="{StaticResource SwitchCheckBox}"
                    Content="{loc:Tr 显示预览版/Beta}"
                    VerticalAlignment="Center"
                    Checked="OnChannelChanged" Unchecked="OnChannelChanged" />
        </Grid>
      </Border>

      <ScrollViewer x:Name="DetailScroll" Grid.Row="4" Margin="0,10,0,0" Padding="0,0,8,0"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    ScrollChanged="OnDetailScrollChanged">
        <!-- 版本分组**全部在这里动态建**（一个项目可能几十上百组）。
             每组是一个可折叠标题（`Fabric 1.20.1` / `Fabric 1.20.1 beta`），
             组内行由 CollapsibleGroup 懒建（一页 60 行 + 「加载更多」）；
             分组本身也是一批 12 组地铺，滚到底再续。
             ⚠️ 不要写死一个 CollapsibleGroup 放在 XAML 里：那样"只显示匹配的那一组"
                的写法会跟着模板一起传下去，用户就再也看不到旧版本了。 -->
        <StackPanel x:Name="DetailGroups" />
      </ScrollViewer>

      <TextBlock x:Name="DetailHint" Grid.Row="5" Margin="0,10,0,0"
                 Style="{StaticResource ModPickHint}" />
    </Grid>
  </Grid>
</UserControl>
