<UserControl x:Class="Mosslight.App.Views.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
             xmlns:views="clr-namespace:Mosslight.App.Views"
             FontFamily="{StaticResource UiFont}">
  <!--
    ⚠️ 差别只有五处，都摆在 `ModContentTypes.cs` 那张表里 —— 页面代码里没有
    ⚠️ **页顶那排「排序：相关度 / 下载量 / 关注数 / 最新 / 最近更新」2026-10 整排删掉了**
    ⚠️ 图标那一格是**两层**：后面一个 64×64 的占位底块（#ModCardIconWell），
    ⚠️ 右边那块 320px 的「已装的模组」面板（列表 + 启用/禁用 + 删除）**已经删掉**：

    设计说明见 docs/design-notes.md#mosslight-app-views-modspage-xaml
  -->
  <Grid Margin="32,28,32,28">

    <!-- ==================== 一级：搜索结果 ==================== -->
    <Grid x:Name="ResultsPane">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />   <!-- 0 标题 -->
        <RowDefinition Height="Auto" />   <!-- 1 副标题 -->
        <RowDefinition Height="Auto" />   <!-- 2 搜索 -->
        <RowDefinition Height="Auto" />   <!-- 3 加载条 -->
        <RowDefinition Height="Auto" />   <!-- 4 网络告警 -->
        <RowDefinition Height="*" />      <!-- 5 结果（整宽） -->
      </Grid.RowDefinitions>

      <!-- 标题 / 副标题：文字由类型决定（构造函数里按 ModContentType 设） -->
      <TextBlock x:Name="PageTitleText" Grid.Row="0" Style="{StaticResource PageTitle}" />
      <TextBlock x:Name="PageSubtitleText" Grid.Row="1" Margin="0,6,0,0"
                 Style="{StaticResource PageSubtitle}" />

      <!--
           ⚠️ 这一块的结构是照 1.0.0 的下载页搜索卡来的：标题一行、关键词一行、

 设计说明见 docs/design-notes.md#mosslight-app-views-modspage-xaml
-->
      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14,16,14">
        <StackPanel>
          <TextBlock x:Name="SearchCardTitle" Style="{StaticResource SectionTitle}" />

          <!-- ⚠️ 搜索框和提示语叠在同一个格子里：WPF 的 TextBox **没有** placeholder，
                只能用一层 `IsHitTestVisible="False"` 的 TextBlock 叠上去
                （点得到下面那个输入框，文字也不会被选走）。
                文案按类型变（构造函数里设），显示/隐藏见 ModsPage.xaml.cs 的 UpdateQueryHint。 -->
          <Grid Margin="0,10,0,0">
            <!--
 ⚠️ 这个搜索框**比 BaseTextBox 默认矮一档**（上下内边距 7 → 3）：
                 ⚠️ 只改内边距，**不给 Height**：写死高度的话 125% / 150% 缩放下
                 ⚠️ 顺带一句：默认 7 为什么能撑到 51 还没查清（比"19px 文字 + 14 padding

 设计说明见 docs/design-notes.md#mosslight-app-views-modspage-xaml
-->
            <TextBox x:Name="QueryBox"
                     Style="{StaticResource BaseTextBox}" Padding="10,3"
                     KeyDown="OnQueryKeyDown" />
            <TextBlock x:Name="QueryHint" IsHitTestVisible="False"
                       Margin="11,0,0,0" VerticalAlignment="Center"
                       FontSize="14" Foreground="{DynamicResource TextFaintBrush}"
                       TextTrimming="CharacterEllipsis" />
          </Grid>

          <!-- 筛选：游戏版本 / 加载器 / 分类 / 排序
               ⚠️ 每格是「标签 + 下拉」两列，标签宽度 Auto、下拉占满剩下的 ——
                  写成等分的四列会让"游戏版本:"这种长标签把下拉挤得很窄。 -->
          <Grid x:Name="FilterGrid" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{loc:Tr 游戏版本}" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="GameVersionBox" Grid.Column="1" Margin="0,0,14,0"
                      SelectionChanged="OnFilterChanged" />

            <TextBlock x:Name="LoaderLabel" Grid.Column="2" Text="{loc:Tr 加载器}"
                       Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="LoaderBox" Grid.Column="3" Margin="0,0,14,0"
                      SelectionChanged="OnFilterChanged" />

            <TextBlock x:Name="CategoryLabel" Grid.Column="4" Text="{loc:Tr 分类}"
                       Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="CategoryBox" Grid.Column="5" Margin="0,0,14,0"
                      SelectionChanged="OnFilterChanged" />

            <TextBlock Grid.Column="6" Text="{loc:Tr 排序}" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="SortBox" Grid.Column="7" SelectionChanged="OnFilterChanged" />
          </Grid>

          <!-- 按钮行 -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="SearchButton"
                    Style="{StaticResource PrimaryButton}" Click="OnSearchClick" />
            <Button x:Name="ResetButton" Margin="8,0,0,0"
                    Content="{loc:Tr 重置}"
                    Style="{StaticResource GhostButton}" Click="OnResetClick" />
          </StackPanel>

          <!-- 状态行：搜索结果数 / 装东西的进度。⚠️ 它归**列表页**，只在列表页上说话 ——
               写它的地方（`SearchAsync` / `ReportProgress`）都不会把"还在干活"这种话
               单独留在这儿不管：搜索那条路在 finally 里兜底清一次，
               安装那条路（详情页发起）必定以一句结论收尾。 -->
          <TextBlock x:Name="StatusText" Margin="0,8,0,0"
                     Style="{StaticResource HintText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 联网等待：**只给这一页的搜索用**（详情页拉版本列表有它自己那条
           DetailLoading，两个面板各一条，谁也不给谁打灯）。
           收起来时整块 Collapsed，不留一条空条在那儿（新写一个 0 高度的洞，比不加还难看）。 -->
      <views:LoadingBar x:Name="SearchLoading" Grid.Row="3" Margin="0,12,0,0" />

      <!-- 网络告警：拉不到的时候**明说**，而且要给出原因 -->
      <Border x:Name="NoticeBanner" Grid.Row="4" Visibility="Collapsed"
              Style="{StaticResource ErrorBanner}" Margin="0,12,0,0" Padding="14,10,14,10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="！" Style="{StaticResource NoticeIcon}" VerticalAlignment="Center" />
          <TextBlock x:Name="NoticeText" Margin="10,0,0,0"
                     Style="{StaticResource NoticeTitle}" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 结果：**整页宽**（这一页不走"列表 + 右侧详情栏"那种二级布局） -->
      <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,12,14,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{loc:Tr 搜索结果}" Style="{StaticResource SectionTitle}" />
          <ListBox x:Name="ResultList" Grid.Row="1" Margin="0,8,0,0"
                   Style="{StaticResource BaseListBox}"
                   ItemContainerStyle="{StaticResource ModCardRow}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.ScrollChanged="OnResultsScrollChanged" />
          <!-- 空结果文案由类型决定（构造函数里设，例：「没有找到资源包，…」）
               ⚠️ 一开始就 **Collapsed**：还没搜过的时候把"没有找到"挂在页面上，
                  看着就像搜坏了（1.0.0 是先搜一屏热门再说话，见 ModsPage.OnFirstLoaded）。 -->
          <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="0,16,0,0"
                     Visibility="Collapsed"
                     Style="{StaticResource EmptyState}" VerticalAlignment="Top" />
        </Grid>
      </Border>
    </Grid>

    <!-- ==================== 二级：项目详情 ====================
         跟 1.0.0 的 _make_detail_page 一个排法：
         · 顶部「← 返回」固定不滚
         · 项目详情卡固定不滚
         · **只有版本分组那一块滚**（Fabric API 那种项目几百个版本，
           整页滚的话"返回"会被顶出屏幕）
         · 底部那行"下载会落到 …"固定，随时看得见装到哪 -->
    <Grid x:Name="DetailPane" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />   <!-- 0 返回 -->
        <RowDefinition Height="Auto" />   <!-- 1 项目详情卡 -->
        <RowDefinition Height="Auto" />   <!-- 2 加载条 -->
        <RowDefinition Height="*" />      <!-- 3 匹配你选的版本（只有它滚） -->
        <RowDefinition Height="Auto" />   <!-- 4 下载会落到 … -->
      </Grid.RowDefinitions>

      <!-- QSS 的 #IconButton 是 16px 字（比旁边的正文大一档），高度 34 -->
      <Button x:Name="BackButton" Grid.Row="0" HorizontalAlignment="Left"
              Style="{StaticResource IconButton}"
              FontSize="16" Padding="10,0" Height="34"
              Click="OnBackToResultsClick" />

      <Border Grid.Row="1" Style="{StaticResource ModDetailCard}" Margin="0,10,0,0" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 图标：底块 + 图两层（图没下来也不会是空洞），跟搜索结果卡同一个做法 -->
          <Border x:Name="DetailIconWell" Grid.Column="0" Style="{StaticResource ModDetailIconWell}">
            <Image x:Name="DetailIcon" Width="96" Height="96" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>

          <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <!-- 名字 + slug。⚠️ 用 Grid 而不是横向 StackPanel：
                 横向 StackPanel 不给子元素宽度约束，名字再长也不会出省略号。 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="DetailName" Grid.Column="0"
                         Style="{StaticResource ModDetailName}" />
              <TextBlock x:Name="DetailSlug" Grid.Column="1" Margin="8,0,0,0"
                         Style="{StaticResource ModDetailSlug}" TextTrimming="CharacterEllipsis" />
              <!-- 收藏：一颗星，点一下切一次（`App.Favorites`）。
                   文案在代码里刷（「☆ 收藏」/「★ 已收藏」），所以 Content 不写在这里。 -->
              <Button x:Name="FavoriteButton" Grid.Column="2" Margin="8,0,0,0"
                      Style="{StaticResource IconButton}"
                      FontSize="13" Padding="8,0" Height="26"
                      Click="OnFavoriteClick" />
            </Grid>

            <TextBlock x:Name="DetailMeta" Margin="0,6,0,0"
                       Style="{StaticResource ModDetailMeta}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DetailDesc" Margin="0,6,0,0"
                       Style="{StaticResource ModDetailDesc}" />
            <StackPanel x:Name="DetailBadges" Orientation="Horizontal" Margin="0,8,0,0" />
            <TextBlock x:Name="DetailStats" Margin="0,6,0,0"
                       Style="{StaticResource ModDetailStats}" />
          </StackPanel>
        </Grid>
      </Border>

      <views:LoadingBar x:Name="DetailLoading" Grid.Row="2" Margin="0,12,0,0" />

      <ScrollViewer x:Name="DetailScroll" Grid.Row="3" Margin="0,12,0,0" Padding="0,0,8,0"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 版本行**全部在这里动态建**（一个项目可能上千个版本）。
             排版照 PCL：一列版本行，上面没有分组标题；行由 CollapsibleGroup 懒建
             （一页 60 行 + 底部「加载更多」），所以一次不会建出上千个控件。
             ⚠️ 不要写死一个 CollapsibleGroup 放在 XAML 里：那样"只显示匹配的那一组"
                的写法会跟着模板一起传下去，用户就再也看不到旧版本了。 -->
        <StackPanel x:Name="DetailGroups" />
      </ScrollViewer>

      <TextBlock x:Name="DetailHint" Grid.Row="4" Margin="0,10,0,0"
                 Style="{StaticResource ModPickHint}" />
    </Grid>
  </Grid>
</UserControl>
