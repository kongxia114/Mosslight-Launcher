<Window x:Class="Mosslight.App.Views.NewAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
        Title="Mosslight Launcher"
        Width="560" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPageBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!-- 微软官方 logo 的字标部分（D:\开发工程\Microsoft.svg 里的 path）。
             方块用 Rectangle 摆，字标用矢量几何 —— 不引图片、不依赖字体。 -->
        <StreamGeometry x:Key="MicrosoftWordmark">M44.836,4.6V18.4h-2.4V7.583H42.4L38.119,18.4H36.531L32.142,7.583h-.029V18.4H29.9V4.6h3.436L37.3,14.83h.058L41.545,4.6Zm2,1.049a1.268,1.268,0,0,1,.419-.967,1.413,1.413,0,0,1,1-.39,1.392,1.392,0,0,1,1.02.4,1.3,1.3,0,0,1,.4.958,1.248,1.248,0,0,1-.414.953,1.428,1.428,0,0,1-1.01.385A1.4,1.4,0,0,1,47.25,6.6a1.261,1.261,0,0,1-.409-.948M49.41,18.4H47.081V8.507H49.41Zm7.064-1.694a3.213,3.213,0,0,0,1.145-.241,4.811,4.811,0,0,0,1.155-.635V18a4.665,4.665,0,0,1-1.266.481,6.886,6.886,0,0,1-1.554.164,4.707,4.707,0,0,1-4.918-4.908,5.641,5.641,0,0,1,1.4-3.932,5.055,5.055,0,0,1,3.955-1.545,5.414,5.414,0,0,1,1.324.168,4.431,4.431,0,0,1,1.063.39v2.233a4.763,4.763,0,0,0-1.1-.611,3.184,3.184,0,0,0-1.15-.217,2.919,2.919,0,0,0-2.223.9,3.37,3.37,0,0,0-.847,2.416,3.216,3.216,0,0,0,.813,2.338,2.936,2.936,0,0,0,2.209.837M65.4,8.343a2.952,2.952,0,0,1,.5.039,2.1,2.1,0,0,1,.375.1v2.358a2.04,2.04,0,0,0-.534-.255,2.646,2.646,0,0,0-.852-.12,1.808,1.808,0,0,0-1.448.722,3.467,3.467,0,0,0-.592,2.223V18.4H60.525V8.507h2.329v1.559h.038A2.729,2.729,0,0,1,63.855,8.8,2.611,2.611,0,0,1,65.4,8.343m1,5.254A5.358,5.358,0,0,1,67.792,9.71a5.1,5.1,0,0,1,3.85-1.434,4.742,4.742,0,0,1,3.623,1.381,5.212,5.212,0,0,1,1.3,3.729,5.257,5.257,0,0,1-1.386,3.83,5.019,5.019,0,0,1-3.772,1.424,4.935,4.935,0,0,1-3.652-1.352A4.987,4.987,0,0,1,66.406,13.6m2.425-.077a3.535,3.535,0,0,0,.7,2.368,2.505,2.505,0,0,0,2.011.818,2.345,2.345,0,0,0,1.934-.818,3.783,3.783,0,0,0,.664-2.425,3.651,3.651,0,0,0-.688-2.411,2.389,2.389,0,0,0-1.929-.813,2.44,2.44,0,0,0-1.988.852,3.707,3.707,0,0,0-.707,2.43m11.2-2.416a1,1,0,0,0,.318.785,5.426,5.426,0,0,0,1.4.717,4.767,4.767,0,0,1,1.959,1.256,2.6,2.6,0,0,1,.563,1.689A2.715,2.715,0,0,1,83.2,17.794a4.558,4.558,0,0,1-2.9.847,6.978,6.978,0,0,1-1.362-.149,6.047,6.047,0,0,1-1.265-.38v-2.29a5.733,5.733,0,0,0,1.367.7,4,4,0,0,0,1.328.26,2.365,2.365,0,0,0,1.164-.221.79.79,0,0,0,.375-.741,1.029,1.029,0,0,0-.39-.813,5.768,5.768,0,0,0-1.477-.765,4.564,4.564,0,0,1-1.829-1.213,2.655,2.655,0,0,1-.539-1.713,2.706,2.706,0,0,1,1.063-2.2A4.243,4.243,0,0,1,81.5,8.256a6.663,6.663,0,0,1,1.164.115,5.161,5.161,0,0,1,1.078.3v2.214a4.974,4.974,0,0,0-1.078-.529,3.6,3.6,0,0,0-1.222-.221,1.781,1.781,0,0,0-1.034.26.824.824,0,0,0-.371.712M85.278,13.6A5.358,5.358,0,0,1,86.664,9.71a5.1,5.1,0,0,1,3.849-1.434,4.743,4.743,0,0,1,3.624,1.381,5.212,5.212,0,0,1,1.3,3.729,5.259,5.259,0,0,1-1.386,3.83,5.02,5.02,0,0,1-3.773,1.424,4.934,4.934,0,0,1-3.652-1.352A4.987,4.987,0,0,1,85.278,13.6m2.425-.077a3.537,3.537,0,0,0,.7,2.368,2.506,2.506,0,0,0,2.011.818,2.345,2.345,0,0,0,1.934-.818,3.783,3.783,0,0,0,.664-2.425,3.651,3.651,0,0,0-.688-2.411,2.39,2.39,0,0,0-1.93-.813,2.439,2.439,0,0,0-1.987.852,3.707,3.707,0,0,0-.707,2.43m15.464-3.109H99.7V18.4H97.341V10.412H95.686V8.507h1.655V7.13a3.423,3.423,0,0,1,1.015-2.555,3.561,3.561,0,0,1,2.6-1,5.807,5.807,0,0,1,.751.043,2.993,2.993,0,0,1,.577.13V5.764a2.422,2.422,0,0,0-.4-.164,2.107,2.107,0,0,0-.664-.1,1.407,1.407,0,0,0-1.126.457A2.017,2.017,0,0,0,99.7,7.313V8.507h3.469V6.283l2.339-.712V8.507h2.358v1.906h-2.358v4.629a1.951,1.951,0,0,0,.332,1.29,1.326,1.326,0,0,0,1.044.375,1.557,1.557,0,0,0,.486-.1,2.294,2.294,0,0,0,.5-.231V18.3a2.737,2.737,0,0,1-.736.231,5.029,5.029,0,0,1-1.015.106,2.887,2.887,0,0,1-2.209-.784,3.341,3.341,0,0,1-.736-2.363Z</StreamGeometry>
        <!--
            类型选择的"一行"：平时透明，悬停浮起一点，选中才给强调条 + 强调色标题。
            没有单选圆圈 —— 圆点 + 大卡片会把这一页压得很重，列表更接近启动器自己的侧栏语言。
        -->
        <Style x:Key="TypeOption" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                    Padding="{TemplateBinding Padding}" />
                            <Border x:Name="Bar" Width="3" Margin="0,8" CornerRadius="2"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{DynamicResource AccentBrush}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        新建档案向导：一个窗口、五个视图，前进/后退只切 Visibility，不弹第二个窗。
        窗口高度固定（ResizeMode=NoResize），内容多的视图自己滚动，避免切换时窗口跳动。
        视图顺序：类型 → 正版 / 认证服务器 / 第三方登录 / 离线。
    -->
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题 -->
            <RowDefinition Height="Auto" />   <!-- 副标题 -->
            <RowDefinition Height="*" />      <!-- 视图区 -->
            <RowDefinition Height="Auto" />   <!-- 状态行 -->
            <RowDefinition Height="Auto" />   <!-- 按钮行 -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Text="{loc:Tr 新建档案}" FontSize="20" FontWeight="Bold" />
        <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,6,0,0"
                   Style="{StaticResource HintText}" TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="0,14,0,0">

            <!-- ① 选择类型 -->
            <StackPanel x:Name="TypeView">
                <ListBox x:Name="TypeList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TypeOption}"
                         SelectionChanged="OnTypeChanged">
                    <ListBoxItem Tag="microsoft">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Grid.Column="0" Width="22" Height="22" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Data="M11,1.4 L19,4.5 V10.5 C19,15.3 15.7,19.1 11,20.7 C6.3,19.1 3,15.3 3,10.5 V4.5 Z" />
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M7.3,10.4 L9.8,12.9 L14.9,7.8" />
                            </Canvas>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 正版验证}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Tr 用微软账号登录（需要先购买正版）}"
                                           Style="{StaticResource HintText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="thirdparty">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Grid.Column="0" Width="22" Height="22" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Canvas.Left="7.5" Canvas.Top="1.5"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         StrokeThickness="1.6" />
                                <Ellipse Width="7" Height="7" Canvas.Left="1" Canvas.Top="13"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         StrokeThickness="1.6" />
                                <Ellipse Width="7" Height="7" Canvas.Left="14" Canvas.Top="13"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         StrokeThickness="1.6" />
                                <Line X1="11" Y1="8.5" X2="11" Y2="13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" />
                                <Line X1="8" Y1="13" X2="5.5" Y2="16.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" />
                                <Line X1="14" Y1="13" X2="16.5" Y2="16.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" />
                            </Canvas>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 第三方验证}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Tr 用第三方皮肤站登录（如 LittleSkin）}"
                                           Style="{StaticResource HintText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="offline">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Grid.Column="0" Width="22" Height="22" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <Ellipse Width="15.4" Height="15.4" Canvas.Left="3.3" Canvas.Top="3.3"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         StrokeThickness="1.6" />
                                <Line X1="4" Y1="18" X2="18" Y2="4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 离线验证}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Tr 只在本机生效，进不了正版服务器}"
                                           Style="{StaticResource HintText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>

            <!-- ② 正版（微软） -->
            <StackPanel x:Name="MicrosoftView" Visibility="Collapsed">
                <Border Background="{DynamicResource BgControlBrush}"
                        BorderBrush="{DynamicResource BorderControlBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center">
                        <Viewbox HorizontalAlignment="Center" Height="26">
                            <Canvas Width="108" Height="24">
                                <Path Data="{StaticResource MicrosoftWordmark}"
                                      Fill="{DynamicResource TextBrush}" />
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="10.931" Height="10.931" Fill="#f25022" />
                        <Rectangle Canvas.Left="12.069" Canvas.Top="0" Width="10.931" Height="10.931" Fill="#7fba00" />
                        <Rectangle Canvas.Left="0" Canvas.Top="12.069" Width="10.931" Height="10.931" Fill="#00a4ef" />
                        <Rectangle Canvas.Left="12.069" Canvas.Top="12.069" Width="10.931" Height="10.931" Fill="#ffb900" />
                            </Canvas>
                        </Viewbox>
                        <Button x:Name="MsLoginButton" Margin="0,14,0,0" MinWidth="220"
                                Content="{loc:Tr 开始正版验证}"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnMicrosoftLoginClick" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="{loc:Tr 购买正版}" Style="{StaticResource TextLinkButton}"
                                    Click="OnBuyGameClick" />
                            <Button Content="{loc:Tr 前往官网}" Margin="16,0,0,0"
                                    Style="{StaticResource TextLinkButton}" Click="OnOfficialSiteClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ③ 选择认证服务器 -->
            <StackPanel x:Name="ServerView" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr 认证服务器}" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ServerCombo" Margin="0,6,0,0"
                          SelectionChanged="OnServerChanged">
                    <ComboBoxItem Content="LittleSkin（https://littleskin.cn/api/yggdrasil）" Tag="littleskin" />
                    <ComboBoxItem Content="{loc:Tr 自定义}" Tag="custom" />
                </ComboBox>
                <TextBox x:Name="CustomServerBox" Margin="0,8,0,0" Visibility="Collapsed"
                         Style="{StaticResource BaseTextBox}"
                         ToolTip="{loc:Tr 例如 https://example.com/api/yggdrasil}" />
                <TextBlock Text="{loc:Tr 用户名}" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                <TextBox x:Name="UserNameBox" Margin="0,6,0,0"
                         Style="{StaticResource BaseTextBox}" />

                <TextBlock Text="{loc:Tr 密码}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                <!-- 密码框用主题里的隐式 PasswordBox 样式（BaseTextBox 只认 TextBox） -->
                <PasswordBox x:Name="PasswordBoxControl" Margin="0,6,0,0"
                             KeyDown="OnPasswordKeyDown" />

                <TextBlock Margin="0,8,0,0"
                           Text="{loc:Tr 走标准 Yggdrasil 协议；地址一般以 /api/yggdrasil 结尾。}"
                           Style="{StaticResource HintText}" TextWrapping="Wrap" />

                <Button x:Name="OAuthEntryButton" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Content="{loc:Tr 使用网页授权登录}" Style="{StaticResource GhostButton}"
                        Click="OnOAuthEntryClick" />
            </StackPanel>

            <!-- ④ 第三方登录 -->
            <StackPanel x:Name="LoginView" Visibility="Collapsed">
                <TextBlock x:Name="LoginServerText" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                <Button x:Name="OAuthButton" Margin="0,14,0,0" MinWidth="220"
                        Content="{loc:Tr 用 LittleSkin 登录}"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnOAuthClick" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{loc:Tr 前往官网}" Style="{StaticResource TextLinkButton}"
                            Click="OnOfficialSiteClick" />
                    <Button Content="{loc:Tr 改用账号密码登录}" Margin="16,0,0,0"
                            Style="{StaticResource TextLinkButton}" Click="OnPasswordLoginClick" />
                </StackPanel>
            </StackPanel>

            <!-- ⑤ 离线 -->
            <StackPanel x:Name="OfflineView" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr 玩家 ID}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PlayerIdBox" Margin="0,6,0,0"
                         Style="{StaticResource BaseTextBox}" MaxLength="16" />

                <TextBlock Text="{loc:Tr UUID 生成标准}" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                <StackPanel Margin="0,6,0,0">
                    <RadioButton x:Name="UuidStandardRadio" GroupName="uuid" IsChecked="True"
                                 Content="{loc:Tr 行业规范（OfflinePlayer: 名字的 MD5）}" />
                    <RadioButton x:Name="UuidLegacyRadio" GroupName="uuid" Margin="0,6,0,0"
                                 Content="{loc:Tr 旧版（早期启动器的算法）}" />
                    <RadioButton x:Name="UuidCustomRadio" GroupName="uuid" Margin="0,6,0,0"
                                 Content="{loc:Tr 自定义}" Checked="OnUuidCustomChecked" />
                </StackPanel>
                <TextBox x:Name="CustomUuidBox" Margin="0,8,0,0" Visibility="Collapsed"
                         Style="{StaticResource BaseTextBox}"
                         ToolTip="{loc:Tr 32 位十六进制，可带连字符}" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0"
                   Foreground="{DynamicResource AccentTextBrush}"
                   FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="BackButton" HorizontalAlignment="Left"
                    Content="{loc:Tr 返回}" Style="{StaticResource GhostButton}"
                    Click="OnBackClick" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{loc:Tr 取消}"
                        Style="{StaticResource BaseButton}" Click="OnCancelClick" />
                <Button x:Name="NextButton" Margin="10,0,0,0"
                        Content="{loc:Tr 继续}" Style="{StaticResource PrimaryButton}"
                        Click="OnNextClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
