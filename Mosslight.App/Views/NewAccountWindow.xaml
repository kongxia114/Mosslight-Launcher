<Window x:Class="Mosslight.App.Views.NewAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
        Title="Mosslight Launcher"
        Width="560" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPageBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!--
            类型选择的"一行"：平时透明，悬停浮起一点，选中才给强调条 + 强调色标题。
            没有单选圆圈 —— 圆点 + 大卡片会把这一页压得很重，列表更接近启动器自己的侧栏语言。
        -->
        <Style x:Key="TypeOption" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                    Padding="{TemplateBinding Padding}" />
                            <Border x:Name="Bar" Width="3" Margin="0,8" CornerRadius="2"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{DynamicResource AccentBrush}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        新建档案向导：一个窗口、五个视图，前进/后退只切 Visibility，不弹第二个窗。
        窗口高度固定（ResizeMode=NoResize），内容多的视图自己滚动，避免切换时窗口跳动。
        视图顺序：类型 → 正版 / 认证服务器 / 第三方登录 / 离线。
    -->
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题 -->
            <RowDefinition Height="Auto" />   <!-- 副标题 -->
            <RowDefinition Height="*" />      <!-- 视图区 -->
            <RowDefinition Height="Auto" />   <!-- 状态行 -->
            <RowDefinition Height="Auto" />   <!-- 按钮行 -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Text="{loc:Tr 新建档案}" FontSize="20" FontWeight="Bold" />
        <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,6,0,0"
                   Style="{StaticResource HintText}" TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="0,14,0,0">

            <!-- ① 选择类型 -->
            <StackPanel x:Name="TypeView">
                <ListBox x:Name="TypeList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TypeOption}"
                         SelectionChanged="OnTypeChanged">
                    <ListBoxItem Tag="microsoft">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Grid.Column="0" Width="22" Height="22" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                      Data="M11,1.4 L19,4.5 V10.5 C19,15.3 15.7,19.1 11,20.7 C6.3,19.1 3,15.3 3,10.5 V4.5 Z" />
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M7.3,10.4 L9.8,12.9 L14.9,7.8" />
                            </Canvas>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 正版验证}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Tr 用微软账号登录（需要先购买正版）}"
                                           Style="{StaticResource HintText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="thirdparty">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Grid.Column="0" Width="22" Height="22" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Canvas.Left="7.5" Canvas.Top="1.5"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         StrokeThickness="1.6" />
                                <Ellipse Width="7" Height="7" Canvas.Left="1" Canvas.Top="13"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         StrokeThickness="1.6" />
                                <Ellipse Width="7" Height="7" Canvas.Left="14" Canvas.Top="13"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         StrokeThickness="1.6" />
                                <Line X1="11" Y1="8.5" X2="11" Y2="13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" />
                                <Line X1="8" Y1="13" X2="5.5" Y2="16.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" />
                                <Line X1="14" Y1="13" X2="16.5" Y2="16.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" />
                            </Canvas>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 第三方验证}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Tr 用第三方皮肤站登录（如 LittleSkin）}"
                                           Style="{StaticResource HintText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem Tag="offline">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas Grid.Column="0" Width="22" Height="22" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <Ellipse Width="15.4" Height="15.4" Canvas.Left="3.3" Canvas.Top="3.3"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         StrokeThickness="1.6" />
                                <Line X1="4" Y1="18" X2="18" Y2="4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Tr 离线验证}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Tr 只在本机生效，进不了正版服务器}"
                                           Style="{StaticResource HintText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>

            <!-- ② 正版（微软） -->
            <StackPanel x:Name="MicrosoftView" Visibility="Collapsed">
                <Border Background="{DynamicResource BgControlBrush}"
                        BorderBrush="{DynamicResource BorderControlBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Microsoft" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <Button x:Name="MsLoginButton" Margin="0,14,0,0" MinWidth="220"
                                Content="{loc:Tr 开始正版验证}"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnMicrosoftLoginClick" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="{loc:Tr 购买正版}" Style="{StaticResource TextLinkButton}"
                                    Click="OnBuyGameClick" />
                            <Button Content="{loc:Tr 前往官网}" Margin="16,0,0,0"
                                    Style="{StaticResource TextLinkButton}" Click="OnOfficialSiteClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ③ 选择认证服务器 -->
            <StackPanel x:Name="ServerView" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr 认证服务器}" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ServerCombo" Margin="0,6,0,0"
                          SelectionChanged="OnServerChanged">
                    <ComboBoxItem Content="LittleSkin（https://littleskin.cn/api/yggdrasil）" Tag="littleskin" />
                    <ComboBoxItem Content="{loc:Tr 自定义}" Tag="custom" />
                </ComboBox>
                <TextBox x:Name="CustomServerBox" Margin="0,8,0,0" Visibility="Collapsed"
                         Style="{StaticResource BaseTextBox}"
                         ToolTip="{loc:Tr 例如 https://example.com/api/yggdrasil}" />
                <TextBlock Margin="0,8,0,0"
                           Text="{loc:Tr 认证服务器一般以 /api/yggdrasil 结尾；自定义服务器目前只支持离线模式。}"
                           Style="{StaticResource HintText}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ④ 第三方登录 -->
            <StackPanel x:Name="LoginView" Visibility="Collapsed">
                <TextBlock x:Name="LoginServerText" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                <Button x:Name="OAuthButton" Margin="0,14,0,0" MinWidth="220"
                        Content="{loc:Tr 用 LittleSkin 登录}"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnOAuthClick" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{loc:Tr 前往官网}" Style="{StaticResource TextLinkButton}"
                            Click="OnOfficialSiteClick" />
                    <Button Content="{loc:Tr 使用密码登录}" Margin="16,0,0,0"
                            Style="{StaticResource TextLinkButton}" Click="OnPasswordLoginClick" />
                </StackPanel>
            </StackPanel>

            <!-- ⑤ 离线 -->
            <StackPanel x:Name="OfflineView" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr 玩家 ID}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PlayerIdBox" Margin="0,6,0,0"
                         Style="{StaticResource BaseTextBox}" MaxLength="16" />

                <TextBlock Text="{loc:Tr UUID 生成标准}" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                <StackPanel Margin="0,6,0,0">
                    <RadioButton x:Name="UuidStandardRadio" GroupName="uuid" IsChecked="True"
                                 Content="{loc:Tr 行业规范（OfflinePlayer: 名字的 MD5）}" />
                    <RadioButton x:Name="UuidLegacyRadio" GroupName="uuid" Margin="0,6,0,0"
                                 Content="{loc:Tr 旧版（早期启动器的算法）}" />
                    <RadioButton x:Name="UuidCustomRadio" GroupName="uuid" Margin="0,6,0,0"
                                 Content="{loc:Tr 自定义}" Checked="OnUuidCustomChecked" />
                </StackPanel>
                <TextBox x:Name="CustomUuidBox" Margin="0,8,0,0" Visibility="Collapsed"
                         Style="{StaticResource BaseTextBox}"
                         ToolTip="{loc:Tr 32 位十六进制，可带连字符}" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0"
                   Foreground="{DynamicResource AccentTextBrush}"
                   FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="BackButton" HorizontalAlignment="Left"
                    Content="{loc:Tr 返回}" Style="{StaticResource GhostButton}"
                    Click="OnBackClick" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{loc:Tr 取消}"
                        Style="{StaticResource BaseButton}" Click="OnCancelClick" />
                <Button x:Name="NextButton" Margin="10,0,0,0"
                        Content="{loc:Tr 继续}" Style="{StaticResource PrimaryButton}"
                        Click="OnNextClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
