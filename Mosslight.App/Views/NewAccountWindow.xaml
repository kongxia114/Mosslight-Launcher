<Window x:Class="Mosslight.App.Views.NewAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
        Title="Mosslight Launcher"
        Width="560" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPageBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}">

    <!--
        新建档案向导：一个窗口、五个视图，前进/后退只切 Visibility，不弹第二个窗。
        窗口高度固定（ResizeMode=NoResize），内容多的视图自己滚动，避免切换时窗口跳动。
        视图顺序：类型 → 正版 / 认证服务器 / 第三方登录 / 离线。
    -->
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题 -->
            <RowDefinition Height="Auto" />   <!-- 副标题 -->
            <RowDefinition Height="*" />      <!-- 视图区 -->
            <RowDefinition Height="Auto" />   <!-- 状态行 -->
            <RowDefinition Height="Auto" />   <!-- 按钮行 -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0"
                   Text="{loc:Tr 新建档案}" FontSize="20" FontWeight="Bold" />
        <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,6,0,0"
                   Style="{StaticResource HintText}" TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="0,14,0,0">

            <!-- ① 选择类型 -->
            <StackPanel x:Name="TypeView">
                <RadioButton x:Name="MsRadio" GroupName="kind" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <Border Background="{DynamicResource BgControlBrush}"
                            BorderBrush="{DynamicResource BorderControlBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr 正版验证}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr 用微软账号登录（需要先购买正版）}"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </RadioButton>
                <RadioButton x:Name="ThirdRadio" GroupName="kind" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <Border Background="{DynamicResource BgControlBrush}"
                            BorderBrush="{DynamicResource BorderControlBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr 第三方验证}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr 用第三方皮肤站登录（如 LittleSkin）}"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </RadioButton>
                <RadioButton x:Name="OfflineRadio" GroupName="kind" HorizontalContentAlignment="Stretch">
                    <Border Background="{DynamicResource BgControlBrush}"
                            BorderBrush="{DynamicResource BorderControlBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr 离线验证}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr 只在本机生效，进不了正版服务器}"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </RadioButton>
            </StackPanel>

            <!-- ② 正版（微软） -->
            <StackPanel x:Name="MicrosoftView" Visibility="Collapsed">
                <Border Background="{DynamicResource BgControlBrush}"
                        BorderBrush="{DynamicResource BorderControlBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Microsoft" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <Button x:Name="MsLoginButton" Margin="0,14,0,0" MinWidth="220"
                                Content="{loc:Tr 开始正版验证}"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnMicrosoftLoginClick" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="{loc:Tr 购买正版}" Style="{StaticResource TextLinkButton}"
                                    Click="OnBuyGameClick" />
                            <Button Content="{loc:Tr 前往官网}" Margin="16,0,0,0"
                                    Style="{StaticResource TextLinkButton}" Click="OnOfficialSiteClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ③ 选择认证服务器 -->
            <StackPanel x:Name="ServerView" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr 认证服务器}" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ServerCombo" Margin="0,6,0,0"
                          SelectionChanged="OnServerChanged">
                    <ComboBoxItem Content="LittleSkin（https://littleskin.cn/api/yggdrasil）" Tag="littleskin" />
                    <ComboBoxItem Content="{loc:Tr 自定义}" Tag="custom" />
                </ComboBox>
                <TextBox x:Name="CustomServerBox" Margin="0,8,0,0" Visibility="Collapsed"
                         Style="{StaticResource BaseTextBox}"
                         ToolTip="{loc:Tr 例如 https://example.com/api/yggdrasil}" />
                <TextBlock Margin="0,8,0,0"
                           Text="{loc:Tr 认证服务器一般以 /api/yggdrasil 结尾；自定义服务器目前只支持离线模式。}"
                           Style="{StaticResource HintText}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- ④ 第三方登录 -->
            <StackPanel x:Name="LoginView" Visibility="Collapsed">
                <TextBlock x:Name="LoginServerText" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                <Button x:Name="OAuthButton" Margin="0,14,0,0" MinWidth="220"
                        Content="{loc:Tr 用 LittleSkin 登录}"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnOAuthClick" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{loc:Tr 前往官网}" Style="{StaticResource TextLinkButton}"
                            Click="OnOfficialSiteClick" />
                    <Button Content="{loc:Tr 使用密码登录}" Margin="16,0,0,0"
                            Style="{StaticResource TextLinkButton}" Click="OnPasswordLoginClick" />
                </StackPanel>
            </StackPanel>

            <!-- ⑤ 离线 -->
            <StackPanel x:Name="OfflineView" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr 玩家 ID}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PlayerIdBox" Margin="0,6,0,0"
                         Style="{StaticResource BaseTextBox}" MaxLength="16" />

                <TextBlock Text="{loc:Tr UUID 生成标准}" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                <StackPanel Margin="0,6,0,0">
                    <RadioButton x:Name="UuidStandardRadio" GroupName="uuid" IsChecked="True"
                                 Content="{loc:Tr 行业规范（OfflinePlayer: 名字的 MD5）}" />
                    <RadioButton x:Name="UuidLegacyRadio" GroupName="uuid" Margin="0,6,0,0"
                                 Content="{loc:Tr 旧版（早期启动器的算法）}" />
                    <RadioButton x:Name="UuidCustomRadio" GroupName="uuid" Margin="0,6,0,0"
                                 Content="{loc:Tr 自定义}" Checked="OnUuidCustomChecked" />
                </StackPanel>
                <TextBox x:Name="CustomUuidBox" Margin="0,8,0,0" Visibility="Collapsed"
                         Style="{StaticResource BaseTextBox}"
                         ToolTip="{loc:Tr 32 位十六进制，可带连字符}" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0"
                   Foreground="{DynamicResource AccentTextBrush}"
                   FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="BackButton" HorizontalAlignment="Left"
                    Content="{loc:Tr 返回}" Style="{StaticResource GhostButton}"
                    Click="OnBackClick" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{loc:Tr 取消}"
                        Style="{StaticResource BaseButton}" Click="OnCancelClick" />
                <Button x:Name="NextButton" Margin="10,0,0,0"
                        Content="{loc:Tr 继续}" Style="{StaticResource PrimaryButton}"
                        Click="OnNextClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
