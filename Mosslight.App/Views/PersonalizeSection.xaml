<UserControl x:Class="Mosslight.App.Views.PersonalizeSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
             FontFamily="{StaticResource UiFont}">
  <!--
    「个性化」的四张卡 —— **没有页头**（标题 / 返回 / tab 都归宿主页面）。

    ⚠️ 为什么抽成控件而不是继续当一页（2026-10 用户要求，照 PCL 的「设置 → 个性化」）：
       PCL 的个性化是**设置里的一个 tab**，不是一个带按钮的独立页。所以内容搬进
       设置页的「个性化」tab，这个控件只负责那四张卡；样式/逻辑（色板、滑杆、对话框）
       还是原来那份，没重写。
    ⚠️ 滚动条归宿主：四张卡本身不包 ScrollViewer，嵌到 tab 里由 tab 的面板滚，
       否则会出现"框里一个滚动条、外面还有一个"。
    ⚠️ 下面两个样式**必须跟着搬**（`PersonalizeSwatch` / `PersonalizeCustomPreview`）：
       它们原来定义在 PersonalizePage 的 `<UserControl.Resources>` 里，页面一删，
       引用它们的 XAML 会在加载期抛 "无法找到名为 … 的资源"（2026-10 合并时踩过一次）。
  -->
  <UserControl.Resources>

    <!--
      预设色块：26px 正圆（对应 Python 的 SWATCH_SIZE）。

      ⚠️ 为什么不用 Controls.xaml 里的 `ColorSwatch`：那个是给「只显示颜色」的
         小圆点用的（20px、固定底色、没有选中态）；主题色这块是**可选中的按钮**，
         选中时外面要有一圈描边（Python 的 `_ColorSwatch.refresh()` 干的事）。
         按约定，本页自己要用的样式放这里并带 `Personalize` 前缀，不动主题字典。
      ⚠️ 圆形色块自己的颜色**不在这里写死**：由代码按「当前强调色 / 主题自带强调色」
         填 Background —— 「默认」那一个的显示色得跟着主题走，写死就漏了浅色主题。
    -->
    <Style x:Key="PersonalizeSwatch" TargetType="{x:Type ToggleButton}">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <!-- CornerRadius 给一个超大值，WPF 自己夹到半宽半高，改尺寸也还是正圆 -->
            <Border x:Name="Dot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="2"
                    CornerRadius="9999"
                    SnapsToDevicePixels="True" />
            <ControlTemplate.Triggers>
              <!-- 未选中 = 描边透明（不是没有描边）：留着一圈位置，选中时圆点不会"长胖" -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
              </Trigger>
              <!-- 选中环的颜色由代码给（Python 用的是调色板的 text_dim） -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Dot" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 「自定义」左边那个预览圆：只显示颜色，不可点，26px，1px 描边 -->
    <Style x:Key="PersonalizeCustomPreview" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="9999" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

  </UserControl.Resources>

  <StackPanel>

    <!-- ============================ 一、主题 ============================ -->
    <Border Style="{StaticResource Card}" Padding="20,15,20,17">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 主题}" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                     Text="{loc:Tr 深浅模式}" />
          <!--
            宽度 200 照抄 Python 的 `setFixedWidth(200)`。
            ⚠️ 事件**在码里接**（构造末尾），不在 XAML 里挂：初始化回填时也会走到
               SelectionChanged，那会把「构造期不该写配置」这条挡住。
          -->
          <ComboBox x:Name="ThemeCombo" Width="200" Margin="10,0,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ============================ 二、主题色 ============================ -->
    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="20,15,20,17">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 主题色}" />

        <!-- 当前主题色：**不是按钮**，只显示「颜色 + 名字」（用户 2026-10 明确要求）。
              十六进制放进 ToolTip —— 可见文字按用户要求只有名字。
              ⚠️ 颜色由代码填（RefreshCurrentAccent），这里**不能**绑 AccentBrush：
                 「默认」那一档要显示的是主题原配色，不是当前生效的那个。 -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Border x:Name="CurrentAccentDot" Style="{StaticResource PersonalizeCustomPreview}"
                  VerticalAlignment="Center" />
          <TextBlock x:Name="CurrentAccentName" Style="{StaticResource FieldLabel}"
                     VerticalAlignment="Center" Margin="9,0,0,0" />
        </StackPanel>

        <!-- 预设色板：4 列网格，格子横间距 14、行间距 8（照抄 QGridLayout 的两个 spacing） -->
        <Grid x:Name="SwatchGrid" Margin="0,10,0,0" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
        </Grid>

        <!-- 自定义色：预览圆点 -->
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                     Text="{loc:Tr 自定义}" />
          <Border x:Name="CustomPreview" Style="{StaticResource PersonalizeCustomPreview}" Margin="10,0,0,0" />
        </StackPanel>

        <!-- R / G / B 三条滑块：标签宽 12、滑块宽 240、数值宽 30（全是 Python 里的数值） -->
        <StackPanel x:Name="SliderRows" Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource FieldLabel}" Width="12" VerticalAlignment="Center" Text="R" />
            <Slider x:Name="RedSlider" Width="240" Minimum="0" Maximum="255" Height="26"
                    Margin="10,0,0,0" VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBlock x:Name="RedValue" Style="{StaticResource HintText}" Width="30" Height="26"
                       Margin="10,0,0,0" VerticalAlignment="Center" Text="0" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource FieldLabel}" Width="12" VerticalAlignment="Center" Text="G" />
            <Slider x:Name="GreenSlider" Width="240" Minimum="0" Maximum="255" Height="26"
                    Margin="10,0,0,0" VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBlock x:Name="GreenValue" Style="{StaticResource HintText}" Width="30" Height="26"
                       Margin="10,0,0,0" VerticalAlignment="Center" Text="0" />
          </StackPanel>

          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource FieldLabel}" Width="12" VerticalAlignment="Center" Text="B" />
            <Slider x:Name="BlueSlider" Width="240" Minimum="0" Maximum="255" Height="26"
                    Margin="10,0,0,0" VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBlock x:Name="BlueValue" Style="{StaticResource HintText}" Width="30" Height="26"
                       Margin="10,0,0,0" VerticalAlignment="Center" Text="0" />
          </StackPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                   Text="{loc:Tr 拖动滑块会直接生效，并取消上面预设色的选中。}" />
      </StackPanel>
    </Border>

    <!-- ============================ 三、背景与动效 ============================ -->
    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="20,15,20,17">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 背景与动效}" />

        <!-- 说明文字必须换行：不换行时它按整句宽度要地方，窗口一窄就被卡片裁掉 -->
        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="{loc:Tr 背景图 / 铺法 / 压暗 / 卡片透明度，以及列表的入场动画。改完立刻生效。}" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="BackgroundButton" Content="{loc:Tr 背景设置…}" Click="OnBackgroundSettings" />
          <Button x:Name="AnimationButton" Content="{loc:Tr 动效设置…}" Margin="10,0,0,0"
                  Click="OnAnimationSettings" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ============================ 四、界面语言 ============================ -->
    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="20,15,20,17">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr 界面语言}" />

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                     Text="{loc:Tr 语言}" />
          <ComboBox x:Name="LanguageCombo" Width="200" Margin="10,0,0,0" />
        </StackPanel>

        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                   Text="{loc:Tr 切换后立刻生效，不需要重启。}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
