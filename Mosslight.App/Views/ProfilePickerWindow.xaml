<Window x:Class="Mosslight.App.Views.ProfilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
        Title="Mosslight Launcher"
        Width="460" SizeToContent="Height" MaxHeight="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPageBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextBrush}">

    <!--
        登录后选角色：LittleSkin 一个账号可以有多个角色，默认取哪个不能替用户决定。
        列表里同时给名字和 UUID —— 同名角色在不同服务器上常见，光看名字会选错。
    -->
    <StackPanel Margin="24,20,24,18">
        <TextBlock Text="{loc:Tr 选择角色}" FontSize="20" FontWeight="Bold" />
        <TextBlock Margin="0,6,0,0" Style="{StaticResource HintText}" TextWrapping="Wrap"
                   Text="{loc:Tr 这个账号有多个角色，先选一个作为默认；之后还能在账户页随时切换。}" />

        <ListBox x:Name="ProfileList" Margin="0,14,0,0" MaxHeight="220"
                 Style="{StaticResource BaseListBox}"
                 MouseDoubleClick="OnListDoubleClick"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Uuid}" Style="{StaticResource HintText}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Tr 取消}" Style="{StaticResource BaseButton}" Click="OnCancelClick" />
            <Button x:Name="OkButton" Content="{loc:Tr 确定}" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="OnOkClick" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
