<UserControl x:Class="Mosslight.App.Views.VersionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Mosslight.App.Infrastructure"
             xmlns:views="clr-namespace:Mosslight.App.Views"
             FontFamily="{StaticResource UiFont}">
  <!--
    「版本设置」页。逐块照搬 1.0.0 的 `ui/pages/version_settings_page.py`（844 行）。

    ## 这一页长什么样（顺序照 1.0.0）
        ← 返回
        版本名（PageTitle）
        版本路径（PageSubtitle）
        这些设置只对该游戏版本生效，不影响其他版本。（HintText）
        ┌ 设置 ┬ Mod 管理 ┐        ← 两个 TabButton，选中项靠下划线
        ─────────────────────      ← CardSep
        启动选项 / 内存分配 / 服务器 / 高级选项（可折叠）四张卡

    ## 为什么是**整页**而不是对话框（1.0.0 文件头原话）
    从「版本」页的卡片和启动面板上的「版本设置」导航进来，左上角「← 返回」回到来的那一页。
    这个工程在「启动」页也定过调子：能不弹窗就不弹 —— 弹窗还会挡住自动化截图。

    ## 改动即时保存（没有保存/取消按钮）
    跟 1.0.0 一样：页面常驻，再挂一对按钮反而要多记一份"打开时的快照"，
    还容易漏掉"切走时忘了保存"。数值走 400ms 防抖（拖滑块会连着发几十次 ValueChanged，
    每次都写盘的话 versions.json 会被写几十遍）。

    ## ⚠️ 四个**空壳**：版本隔离 / 游戏窗口标题 / 内存管理 / 启动前执行命令
    1.0.0 里这四个就是画出来占位的（`_shell_combo` / `_shell_edit`：
    `combo.setEnabled(False)`、`edit.setEnabled(False)`），**不是**"能改但不落盘"——
    它们连改都改不了，控件是灰的、旁边有一句"还没接上"。
    截图里它们看着像普通下拉/输入框，只是**禁用态在静态图里看不出来**。

    2.0 这边逐个查过 `Mosslight.Core`，四个都没有对应能力（详见 .xaml.cs 的类注释），
    所以照 1.0.0 如实做成**禁用 + 说明**：不造"改了不生效"的控件。
    PCL 里那两个「禁用 Java Launch Wrapper / 禁用 LWJGL Unsafe Agent」是 PCL 自己往
    命令行塞补丁的开关，我们没塞补丁，**故意不画**（1.0.0 的取舍，照搬）。

    ## 尺寸都从 version_settings_page.py 和 70-version-settings.qss 抄
      页面内边距        contentsMargins(32, 24, 32, 20)
      标题与 tab 之间     2px（addSpacing(2)），tab 与内容之间 6px（addSpacing(6)）
      滚动内容内边距      (0, 12, 12, 12)，卡片之间 12px
      卡片内边距        (20, 16, 20, 18)；高级选项那张是 (20, 12, 20, 16)
      字段名列宽         140（LABEL_WIDTH，用 MinWidth 而不是固定宽 —— 俄语标签更长）
      固定控件宽         300（FIELD_WIDTH）；内存管理下拉 260
      内存数值标签宽      90（setFixedWidth(90)）
      内存条高          22（memory_bar.BAR_HEIGHT）
      Java 下拉最小宽     300（setMinimumWidth(300)）

    ⚠️ 这里**一个 #rrggbb 都没有**：全部走 {DynamicResource} 或 Controls.xaml 里的具名样式。

    ## 占位文案（Qt 的 setPlaceholderText）在 WPF 里没有对应属性
    Controls.xaml 的「没翻清单」里没有它，因为它本来就不是 QSS —— 是控件属性。
    WPF 的 TextBox 没有 PlaceholderText，所以这里用"同格子里垫一个 TextBlock"的做法
    （样式 `FieldPlaceholder`，见 Controls.xaml 第十六节），
    由 .xaml.cs 的 HookPlaceholder 按 Text 是否为空切换可见性。
    选它而不是 Adorner：离屏截图（App.SaveWindowPng）走的是纯 Measure/Arrange，
    Adorner 层不保证被建出来，垫 TextBlock 一定画得上。
  -->
  <Grid Margin="32,24,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ==================== 头部：返回 + 版本名 + 路径 + 作用域说明 ==================== -->
    <!--
      ⚠️ 版本名 / 路径 / 作用域说明**必须装在卡片里**（2026-10 用户报"字被搞的看不见"）：
         这三行原来直接压在壁纸上，路径和作用域说明用的是 PageSubtitle / HintText
         （暗灰、半透明），遇到亮天空、雪地或白墙就完全糊掉 —— 而版本名是粗白字，
         对比之下就变成"标题看得见、下面两行消失"。
      ⚠️ 返回按钮留在卡片外面：它是 LinkButton（无底色的文字按钮），塞进卡片里反而像标签。
    -->
    <StackPanel Grid.Row="0">
      <Button x:Name="BackButton" HorizontalAlignment="Left"
              Content="{loc:Tr ← 返回}"
              Style="{StaticResource LinkButton}" Click="OnBackClick" />
      <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="20,14,20,16">
        <StackPanel>
          <TextBlock x:Name="NameText" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
          <TextBlock x:Name="PathText" Margin="0,4,0,0"
                     Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
          <TextBlock x:Name="ScopeHint" Margin="0,4,0,0"
                     Style="{StaticResource HintText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ==================== 两个 tab ==================== -->
    <!--
      ⚠️ tab 也必须在**卡片上**（2026-10 跟头部一起改的）：未选中的 TabButton 是暗灰文字、
         自己不带底色，悬在亮壁纸上同样看不见（截图里「Mod 管理」就是糊的）。
         所以这里单独给一层卡片底，别退回"直接压背景"。
      ⚠️ 上边距照 1.0.0 的离屏参考图量的（header 与 tabs 之间 6+2，见原注释）：
         那张图说的是**文字间距**，换成卡片后视觉缝隙由卡片 padding 承担，数值保留。
    -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,8,16,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="TabSettings" Tag="0"
                        Content="{loc:Tr 设置}"
                        Style="{StaticResource TabButton}" Click="OnTabClick" />
          <ToggleButton x:Name="TabMods" Tag="1" Margin="4,0,0,0"
                        Content="{loc:Tr Mod 管理}"
                        Style="{StaticResource TabButton}" Click="OnTabClick" />
        </StackPanel>
        <Border Style="{StaticResource CardSep}" />
      </StackPanel>
    </Border>

    <!-- ==================== 「设置」tab ==================== -->
    <ScrollViewer x:Name="SettingsPane" Grid.Row="2" Margin="0,12,0,0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,12,12,12">

        <!-- ==================== 启动选项 ==================== -->
        <Border x:Name="LaunchCard" Style="{StaticResource Card}" Padding="20,16,20,18">
          <StackPanel>
            <TextBlock Text="{loc:Tr 启动选项}" Style="{StaticResource SectionTitle}" />

            <!-- 版本隔离：空壳（只显示扫描器的判断结果） -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Tr 版本隔离}"
                         Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
              <ComboBox x:Name="IsolateCombo" Grid.Column="1" Margin="10,0,0,0" Width="300" IsEnabled="False" />
            </Grid>
            <TextBlock x:Name="IsolateHint" Margin="0,10,0,0"
                       Style="{StaticResource HintText}" TextWrapping="Wrap" />

            <!-- 游戏窗口标题：空壳 -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Tr 游戏窗口标题}"
                         Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
              <Grid Grid.Column="1" Margin="10,0,0,0" Width="300">
                <TextBox x:Name="WindowTitleBox" IsEnabled="False" />
                <TextBlock x:Name="WindowTitlePlaceholder" Text="{loc:Tr '留空 = 不改'}"
                           Style="{StaticResource FieldPlaceholder}" />
              </Grid>
            </Grid>
            <TextBlock x:Name="TitleHint" Margin="0,10,0,0"
                       Style="{StaticResource HintText}" TextWrapping="Wrap" />

            <!-- 自定义信息：真（它就是游戏给启动器留的那个口子 versionType，也就是 ${version_type}） -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Tr 自定义信息}"
                         Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
              <Grid Grid.Column="1" Margin="10,0,0,0" Width="300">
                <TextBox x:Name="InfoBox" MaxLength="32" TextChanged="OnEditableTextChanged" />
                <TextBlock x:Name="InfoPlaceholder"
                           Style="{StaticResource FieldPlaceholder}" />
              </Grid>
            </Grid>
            <TextBlock x:Name="InfoHint" Margin="0,10,0,0"
                       Style="{StaticResource HintText}" TextWrapping="Wrap" />

            <!-- Java：真 -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Tr Java}"
                         Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
              <ComboBox x:Name="JavaCombo" Grid.Column="1" Margin="10,0,0,0" MinWidth="300"
                        SelectionChanged="OnJavaChanged" />
              <Button x:Name="RescanJavaButton" Grid.Column="2" Margin="10,0,0,0"
                      Content="{loc:Tr 重新扫描}"
                      Style="{StaticResource BaseButton}" Click="OnRescanJavaClick" />
            </Grid>
            <TextBlock x:Name="JavaHint" Margin="0,10,0,0"
                       Style="{StaticResource HintText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- ==================== 内存分配 ==================== -->
        <Border x:Name="MemoryCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,16,20,18">
          <StackPanel>
            <TextBlock Text="{loc:Tr 内存分配}" Style="{StaticResource SectionTitle}" />

            <!-- 三选一：跟随全局设置 / 自动配置（空壳）/ 自定义 -->
            <StackPanel x:Name="MemoryModeRow" Orientation="Horizontal" Margin="0,10,0,0">
              <RadioButton x:Name="MemFollow" GroupName="MemoryMode"
                           Content="{loc:Tr 跟随全局设置}"
                           Checked="OnMemoryModeChanged" />
              <RadioButton x:Name="MemAuto" GroupName="MemoryMode" Margin="20,0,0,0"
                           Content="{loc:Tr 自动配置}" IsEnabled="False" />
              <RadioButton x:Name="MemCustom" GroupName="MemoryMode" Margin="20,0,0,0"
                           Content="{loc:Tr 自定义}"
                           Checked="OnMemoryModeChanged" />
            </StackPanel>
            <TextBlock x:Name="MemoryModeHint" Margin="0,10,0,0"
                       Style="{StaticResource HintText}" TextWrapping="Wrap" />

            <!-- 启动游戏前进行内存优化：空壳 -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Tr 启动游戏前进行内存优化}"
                         Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
              <ComboBox x:Name="OptimizeCombo" Grid.Column="1" Margin="10,0,0,0" Width="300" IsEnabled="False" />
            </Grid>

            <!-- 最小：数字框（1.0.0 是 QSpinBox，不是滑块） -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Tr 最小}"
                         Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
              <views:NumberBox x:Name="MinBox" Grid.Column="1" Margin="10,0,0,0"
                               Minimum="512" Maximum="32768" Step="512" Suffix=" MB" />
            </Grid>

            <!-- 最大：滑块 + 右对齐的数值（固定宽度，拖的时候布局不会推来推去） -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Tr 最大}"
                         Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
              <Slider x:Name="MaxSlider" Grid.Column="1" Margin="10,0,10,0"
                      Style="{StaticResource MemorySlider}"
                      Minimum="512" Maximum="65536" TickFrequency="512"
                      IsSnapToTickEnabled="True"
                      ValueChanged="OnMaxChanged" />
              <TextBlock x:Name="MaxValue" Grid.Column="2" Width="90" TextAlignment="Right"
                         Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Margin="0,10,0,0"
                       Text="{loc:Tr 最小堆不能大于最大堆 —— 两边会自动联动。}"
                       Style="{StaticResource HintText}" />

            <!-- 内存占用条（1.0.0 的 ui/widgets/memory_bar.py，2.0 已翻成 MemoryBar） -->
            <views:MemoryBar x:Name="MemBar" Margin="0,10,0,0" Height="22"
                             UsedBrush="{DynamicResource BorderControlBrush}"
                             HeapBrush="{DynamicResource AccentBrush}"
                             OverheadBrush="{DynamicResource WarnBrush}"
                             EmptyBrush="{DynamicResource BgElevatedBrush}"
                             DangerBrush="{DynamicResource DangerBrush}" />

            <TextBlock x:Name="MemoryLegend" Margin="0,10,0,0"
                       Style="{StaticResource HintText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- ==================== 服务器 ==================== -->
        <Border x:Name="ServerCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,16,20,18">
          <StackPanel>
            <TextBlock Text="{loc:Tr 服务器}" Style="{StaticResource SectionTitle}" />

            <!-- 登录方式：只**显示**当前档案（我们只有离线档案） -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Tr 登录方式}"
                         Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
              <TextBlock x:Name="AccountText" Grid.Column="1" Margin="10,0,0,0"
                         Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button x:Name="ManageAccountButton" Grid.Column="2" Margin="10,0,0,0"
                      Content="{loc:Tr 管理档案}"
                      Style="{StaticResource LinkButton}" Click="OnManageAccountClick" />
            </Grid>
            <TextBlock x:Name="LoginHint" Margin="0,10,0,0"
                       Style="{StaticResource HintText}" TextWrapping="Wrap" />

            <!-- 自动进入服务器：真 -->
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Tr 自动进入服务器}"
                         Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
              <Grid Grid.Column="1" Margin="10,0,0,0" Width="300">
                <TextBox x:Name="ServerBox" TextChanged="OnEditableTextChanged" />
                <TextBlock x:Name="ServerPlaceholder" Text="{loc:Tr 233.233.233.233:12345}"
                           Style="{StaticResource FieldPlaceholder}" />
              </Grid>
            </Grid>
            <TextBlock x:Name="ServerHint" Margin="0,10,0,0"
                       Style="{StaticResource HintText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- ==================== 高级选项（卡片标题本身就是折叠开关，默认收起） ==================== -->
        <Border x:Name="AdvancedCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,12,20,16">
          <StackPanel>
            <ToggleButton x:Name="AdvancedToggle" HorizontalAlignment="Left"
                          Style="{StaticResource SectionToggle}" Click="OnAdvancedToggle" />

            <StackPanel x:Name="AdvancedBody" Margin="0,4,0,0" Visibility="Collapsed">
              <!-- Java 虚拟机参数：真（多行，1.0.0 是 QPlainTextEdit，固定高 72） -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Tr Java 虚拟机参数}"
                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Margin="10,0,0,0">
                  <TextBox x:Name="JvmBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" TextChanged="OnEditableTextChanged" />
                  <TextBlock x:Name="JvmPlaceholder" Text="{loc:Tr 例如 -XX:+UseG1GC}"
                             Style="{StaticResource FieldPlaceholder}"
                             VerticalAlignment="Top" Margin="11,8,11,0" />
                </Grid>
              </Grid>

              <!-- 游戏参数：真 -->
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="140" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Tr 游戏参数}"
                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Margin="10,0,0,0">
                  <TextBox x:Name="GameBox" TextChanged="OnEditableTextChanged" />
                  <TextBlock x:Name="GamePlaceholder"
                             Text="{loc:Tr 例如 --width 1920 --height 1080}"
                             Style="{StaticResource FieldPlaceholder}" />
                </Grid>
              </Grid>

              <!-- 内存管理：空壳 -->
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="140" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Tr 内存管理}"
                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox x:Name="GcCombo" Grid.Column="1" Margin="10,0,0,0" Width="260" IsEnabled="False" />
              </Grid>

              <!-- 启动前执行命令：空壳 -->
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="140" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Tr 启动前执行命令}"
                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Margin="10,0,0,0" Width="300">
                  <TextBox x:Name="PreLaunchBox" IsEnabled="False" />
                  <TextBlock x:Name="PreLaunchPlaceholder" Text="{loc:Tr '留空 = 不执行'}"
                             Style="{StaticResource FieldPlaceholder}" />
                </Grid>
              </Grid>

              <TextBlock x:Name="ShellHint" Margin="0,10,0,0"
                         Style="{StaticResource HintText}" TextWrapping="Wrap" />
              <TextBlock x:Name="AdvancedArgsHint" Margin="0,10,0,0"
                         Style="{StaticResource HintText}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 落盘位置 + 保存失败提示（保存成功时整块收起来，不留空行） -->
        <TextBlock x:Name="SaveHint" Margin="0,14,0,0"
                   Style="{StaticResource HintText}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <!-- ==================== 「Mod 管理」tab ==================== -->
    <!-- ⚠️ 右边留 12，跟「设置」tab 的滚动内容对齐（1.0.0 的 mods 页是
         outer.setContentsMargins(0, 12, 12, 12)）—— 不留的话两张 tab 的卡片右边缘差 12px -->
    <Grid x:Name="ModsPane" Grid.Row="2" Margin="0,24,12,12" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 没装加载器时显示的那张卡（照 PCL 的提示抄的；竖直居中，跟 1.0.0 的
           上下两条 addStretch() 一个效果） -->
      <Border x:Name="ModNoticeCard" Grid.Row="1" VerticalAlignment="Center"
              Style="{StaticResource Card}" Padding="28,26,28,26">
        <StackPanel>
          <TextBlock Text="{loc:Tr 该版本不可使用 Mod}"
                     Style="{StaticResource NoticeTitle}" TextAlignment="Center" />
          <Border Style="{StaticResource CardSep}" Margin="0,12,0,0" />
          <TextBlock x:Name="ModNoticeLine1" Margin="0,12,0,0"
                     Style="{StaticResource EmptyState}" TextWrapping="Wrap" />
          <TextBlock x:Name="ModNoticeLine2" Margin="0,12,0,0"
                     Style="{StaticResource EmptyState}" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="GoDownloadButton" Content="{loc:Tr 转到下载页面}"
                    Style="{StaticResource PrimaryButton}" Click="OnGoDownloadClick" />
            <Button x:Name="PickVersionButton" Margin="12,0,0,0"
                    Content="{loc:Tr 版本选择}"
                    Style="{StaticResource LinkButton}" Click="OnPickVersionClick" />
          </StackPanel>

          <!-- 1.0.0 的 download_tip：按「转到下载页面」之后冒出来的那句话。
               2.0 的下载页已经做好了，所以正常情况下是**直接切页**、这块不显示；
               只有这一页没挂在主窗口上（切不了页）时才拿它兜底说实话。 -->
          <TextBlock x:Name="ModTipText" Margin="0,12,0,0" HorizontalAlignment="Center"
                     Style="{StaticResource HintText}" TextWrapping="Wrap"
                     TextAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!--
 设计说明见 docs/design-notes.md#mosslight-app-views-versionsettingspage-xaml
-->
      <Border x:Name="ModsCard" Grid.Row="1" Style="{StaticResource Card}"
              Padding="20,16,20,12" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 标题 + 条数 + 两个按钮 -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <!-- 标题就是条数（tab 上已经写着「Mod 管理」，这里再写一遍是废话） -->
              <TextBlock x:Name="ModCountText" Style="{StaticResource SectionTitle}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="ModsRefreshButton" Content="{loc:Tr 刷新}"
                      Style="{StaticResource PanelButton}" Click="OnModsRefreshClick" />
              <Button x:Name="ModsFolderButton" Margin="8,0,0,0" Content="{loc:Tr 打开文件夹}"
                      Style="{StaticResource PanelButton}" Click="OnOpenModsFolderClick" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource CardSep}" Margin="0,12,0,0" />

          <!-- 这版的 mods 到底在哪（版本隔离与否算出来的是同一个目录） -->
          <TextBlock x:Name="ModsPathText" Grid.Row="2" Margin="0,10,0,0"
                     Style="{StaticResource HintText}" TextWrapping="Wrap" />

          <ScrollViewer Grid.Row="3" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <StackPanel x:Name="ModRows" />
              <TextBlock x:Name="ModsLoading" Margin="0,10,0,0" Visibility="Collapsed"
                         Style="{StaticResource HintText}" Text="{loc:Tr 读取中…}" />
              <StackPanel x:Name="ModsEmpty" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Style="{StaticResource EmptyState}" TextWrapping="Wrap"
                           Text="{loc:Tr 这个版本的 mods 文件夹是空的。去下载页搜一个装进来，或者把 .jar 放进这个目录。}" />
                <Button Margin="0,12,0,0" HorizontalAlignment="Left"
                        Content="{loc:Tr 去下载 Mod}"
                        Style="{StaticResource PrimaryButton}" Click="OnGoDownloadClick" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
